---
from nexy import usePathname
from src.locales.routes.docs.sidebar import SidebarI18n
pathname = usePathname()
is_modular = pathname.startswith('/docs/modular')
s = SidebarI18n()
routers = {
    "fbr": {"label": s.router_toggle.fbr_label, "desc": s.router_toggle.fbr_desc, "active": not is_modular},
    "modular": {"label": s.router_toggle.modular_label, "desc": s.router_toggle.modular_desc, "active": is_modular},
}
---
<script>
function toggleDropdown() {
    document.getElementById('router-dropdown').classList.toggle('hidden');
}
function selectRouter(modular) {
    document.getElementById('router-toggle').checked = modular;
    switchRouter(modular);
    document.getElementById('router-dropdown').classList.add('hidden');
    document.querySelectorAll('.rlabel').forEach(function(el) {
        el.classList.toggle('hidden', el.dataset.router !== (modular ? 'modular' : 'fbr'));
    });
}
document.addEventListener('click', function(e) {
    var container = document.getElementById('router-container');
    if (container && !container.contains(e.target)) {
        document.getElementById('router-dropdown').classList.add('hidden');
    }
});
</script>
<div id="router-container" class="p-2 relative border border-dashed rounded-2xl corner border-neutral-200/70 dark:border-neutral-800/70 mb-2 ">
    <div class="flex gap-3 items-center cursor-pointer select-none" onclick="toggleDropdown()">
        <div class="border p-2 rounded-xl border-neutral-300 dark:border-neutral-600">
            <svg class="size-5 text-neutral-600 dark:text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <circle cx="12" cy="12" r="4"></circle>
            </svg>
        </div>
        <div class="flex-1 min-w-0">
            {% for key, r in routers.items() %}
            <div class="rlabel {% if not r['active'] %}hidden{% endif %}" data-router="{{ key }}">
                <h2 class="font-medium text-neutral-800 dark:text-neutral-200">{{ r["label"] }}</h2>
                <p class="text-xs text-neutral-500 dark:text-neutral-400">{{ r["desc"] }}</p>
            </div>
            {% endfor %}
        </div>
        <svg class="size-4 shrink-0 text-neutral-400 dark:text-neutral-500 transition-transform" id="dropdown-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m7 15 5 5 5-5"></path>
            <path d="m7 9 5-5 5 5"></path>
        </svg>
    </div>
    <div id="router-dropdown" class="hidden absolute left-0 right-0 top-full mt-1 z-50 bg-background border border-neutral-200 dark:border-neutral-800 rounded-xl shadow-lg overflow-hidden">
        {% for key, r in routers.items() %}
        <div class="flex gap-3 items-center p-3 cursor-pointer select-none transition-colors {% if r["active"] %}bg-neutral-100 dark:bg-neutral-700{% else %}hover:bg-neutral-50 dark:hover:bg-neutral-700/50{% endif %}" onclick="selectRouter({{ "true" if key == "modular" else "false" }})">
            <div class="border p-1.5 rounded-xl border-neutral-300 dark:border-neutral-600">
                <svg class="size-4 text-neutral-600 dark:text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <circle cx="12" cy="12" r="4"></circle>
                </svg>
            </div>
            <div class="flex-1 min-w-0">
                <h2 class="font-medium text-sm text-neutral-800 dark:text-neutral-200">{{ r["label"] }}</h2>
                <p class="text-xs text-neutral-500 dark:text-neutral-400">{{ r["desc"] }}</p>
            </div>
        </div>
        {% endfor %}
    </div>
    <input id="router-toggle" type="checkbox" class="hidden" {% if is_modular %}checked{% endif %}>
</div>
