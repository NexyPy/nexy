---
from "@components/docs/sidebarItems.nexy" import SidebarItems
from "@components/docs/routerToggle.nexy" import RouterToggle
from src.mocks.docs.sidebar import build_sections
from src.locales.routes.docs.sidebar import SidebarI18n
from nexy import usePathname
pathname = usePathname()
is_modular = pathname.startswith('/docs/modular')
s = SidebarI18n()
---
<script>
function switchRouter(modular) {
    window.__router = modular;
    document.querySelectorAll('.router-section, .route-mode').forEach(function(el) {
        el.classList.toggle('hidden', el.dataset.router !== (modular ? 'modular' : 'fbr'));
    });
}
</script>
<aside class="sidebar p-0! pr-2! py-6! flex flex-col gap-1 max-lg:fixed max-lg:top-0 max-lg:-left-72 max-lg:bottom-0 max-lg:z-50 max-lg:w-72 max-lg:h-dvh max-lg:pt-20 max-lg:bg-background max-lg:border-r max-lg:shadow-xl max-lg:transition-all max-lg:duration-300 max-lg:overflow-hidden" id="docs-sidebar">
    <RouterToggle/>

    <aside class="overflow-y-auto flex flex-col gap-4 py-2 pr-2 flex-1">
        <SidebarItems SIDE_BAR_Items={{build_sections(s, "fbr" if not is_modular else "modular")}}/>
    </aside>
</aside>
