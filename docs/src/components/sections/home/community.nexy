---
from "@components/link.nexy" import Link
from src.utils import resolve_url

creator =  "https://avatars.githubusercontent.com/u/108950035?s=400&u=8c53eecafb5ed2d9e0a4ff4c6275710fcf1bf029&v=4"
contributor =  resolve_url("/community")
menbre=  resolve_url("/community")
---
<section
    class="md:flex gap-8  space-y-4 md:space-y-0 items-center  w-full w-container bg-background-second  text-white md:border-x border-border border-dashed p-24 ">
    <aside class="w-106 h-85 flex gap-4 ">
            <div style="background-image: url({{creator}});background-size: cover; background-position: center;" class="p-1 flex items-end size-full bg-red-50/20 border border-border  corner rounded-3xl">
                <div class="w-full flex justify-between items-center p-4  backdrop-blur-sm bg-background/76 text-foreground border border-border rounded-2xl corner ">
                    <div>
                        <h3 class="text-sm font-medium">Espoir LOEMBA</h3>
                    <p class="text-xs tracking-wide font-light  opacity-60">
                        Nexy creator
                    </p>
                    </div>
                    <div class="size-8 border border-border grid place-content-center rounded-xl corner">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                            stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"
                            class="size-4">
                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                            <rect width="4" height="12" x="2" y="9" />
                            <circle cx="4" cy="4" r="2" />
                        </svg>
                    </div>
                </div>
            </div>
            <article class="space-y-4 *:size-40.5">
            <div 
                style="background-image: url();"
                class="  bg-red-50/20 border border-border corner rounded-3xl"> </div>
            <div class=" bg-red-50/20 border border-border corner rounded-3xl"> </div>
            </article>
    </aside>
    <aside class="space-y-4 flex-1 border border-dashed border-border p-8 rounded-4xl corner">
        <h2 class="text-3xl font-medium">Ours Communities</h2>
        <p class="text-base font-light max-w-xl leading-6">
            Nexy upports every major UI framework. Bring your existing components and take advantage of Astro's
            optimized client build performance.
            
        </p>
        <p class="text-base font-light max-w-xl leading-6">
            Nexy upports every major UI framework. Bring your existing components and take advantage of Astro's
        </p>
        <div class="flex items-center gap-4 mt-8 ">
            <Link href="/community"
                className="bg-white text-black font-medium w-fit flex items-center gap-2 px-6 py-3 rounded-full corner">
            <span>Join Community</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4.5 " viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path
                    d="M12.034 12.681a.498.498 0 0 1 .647-.647l9 3.5a.5.5 0 0 1-.033.943l-3.444 1.068a1 1 0 0 0-.66.66l-1.067 3.443a.5.5 0 0 1-.943.033z" />
                <path d="M5 3a2 2 0 0 0-2 2" />
                <path d="M19 3a2 2 0 0 1 2 2" />
                <path d="M5 21a2 2 0 0 1-2-2" />
                <path d="M9 3h1" />
                <path d="M9 21h2" />
                <path d="M14 3h1" />
                <path d="M3 9v1" />
                <path d="M21 9v2" />
                <path d="M3 14v1" />
            </svg>
            </Link>

            <Link href="https://github.com/NexyPy/nexy.git" target="_blank"
                className="border border-white/40 text-white  w-fit md:flex  hidden items-center gap-2 px-6 py-3 rounded-full corner">
            <span>View on Github</span>
            <svg width="20" height="20" class="size-4.5 hidden md:block" viewBox="0 0 24 24" fill="currentColor"
                stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"
                class="lucide lucide-github-icon lucide-github">
                <path
                    d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
            </svg>
            </Link>
        </div>
    </aside>
</section>