---
from "@/locales/routes/team" import Team
from "@components/sections/otherHero.nexy" import OtherHero 

t = Team()
title  = t.title
description = t.description

---
<main class=" overflow-x-hidden">
<OtherHero
    title={{title}}
    description={{description}}
/>
<section class="border-t border-border border-dashed">
    <aside class="w-container py-16 space-y-6">
        <div>
            <ul class="flex gap-4 items-center">
                <li class="bg-foreground text-foreground-second px-4 py-1 rounded-full ">{{t.filter_all}}</li>
                <li>{{t.filter_marketing}}</li>
                <li>{{t.filter_platform_engineering}}</li>
                <li>{{t.filter_ai}}</li>
                <li>{{t.filter_web_app}}</li>
            </ul>
            <ul>

            </ul>
        </div>
        <hr class="opacity-10">
    </aside>
</section>
</main>
