---
from "@components/header.nexy" import Header
from "@components/footer.nexy" import Footer
from "@components/vercel.tsx" import VercelAnalytics

from nexy import Vite

children:prop[NexyElement]
---

<!DOCTYPE html>
<html lang="{{__locale}}" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexy & React | App </title>
    <Vite />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght"@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    <style>
        #nexy-loading-bar { position: fixed; top: 0; left: 0; z-index: 9999; width: 100%; height: 3px; pointer-events: none; opacity: 0; transition: opacity .2s; }
        #nexy-loading-bar .bar { background: linear-gradient(90deg,#3b82f6,#8b5cf6); position: absolute; inset: 0; transform: translateX(-100%); }
        #nexy-loading-bar.active { opacity: 1; }
        #nexy-loading-bar.active .bar { animation: nexy-loading-indeterminate 1.5s infinite ease-in-out; }
        @keyframes nexy-loading-indeterminate { 0% { transform: translateX(-100%); } 50% { transform: translateX(100%); } 100% { transform: translateX(200%); } }
    </style>
    <div id="nexy-loading-bar"><div class="bar"></div></div>
    <script>
        window.__nprogress = {
            _el: document.getElementById('nexy-loading-bar'),
            _timer: null,
            start: function() {
                var self = this;
                if (self._timer) clearTimeout(self._timer);
                self._el.classList.add('active');
            },
            done: function() {
                var self = this;
                self._el.classList.add('active');
                self._timer = setTimeout(function() {
                    self._el.classList.remove('active');
                }, 200);
            }
        };
    </script>
    <script>window.__NEXY_LOCALES={{ _locale_info() | tojson }}</script>
    <script type="module">
        const TABS = [...document.querySelectorAll("#tabs")];
        TABS.forEach((tabs) => {
            if (tabs.children.length <= 1) return
            const tabButtons = [...tabs.children]
            tabButtons.forEach((tab) => {

                tab.addEventListener("click", (e) => {
                    e.preventDefault()
                    const li = e.target.closest("li")
                    const tabname = li.getAttribute("tabname")
                    const codeblock = tabs.nextElementSibling
                    if (!codeblock) return
                    const blocks = [...codeblock.querySelectorAll("[tabname]")]

                    blocks.forEach((block) => {
                        block.classList.toggle("hidden", block.getAttribute("tabname") !== tabname)
                    })

                    tabButtons.forEach((t) => {
                        t.classList.remove("border-b-2", "border-[#ACE8AE]")
                    })
                    li.classList.add("border-b-2", "border-[#ACE8AE]")
                })
            })
        })

        document.documentElement.classList.toggle(
            "dark",
            localStorage.getItem('nexy-theme') === "dark" ||
            (!("nexy-theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches),
        );
    </script>

</head>

<body class="  antialiased min-h-dvh flex flex-col inter ">
    <VercelAnalytics />
    <Header />
    {{children | safe }}
    <Footer />
</body>

</html>
<script__ defer hidden >
        (() => {

            /*
            |--------------------------------------------------------------------------
            | CACHE & STATE
            |--------------------------------------------------------------------------
            */

            const PAGES_CACHE = new Map()
            const PREFETCHED = new Set()

            const supportsViewTransition =
                typeof document.startViewTransition === "function"

            /*
            |--------------------------------------------------------------------------
            | UTILITIES
            |--------------------------------------------------------------------------
            */

            function getURL(link) {
                try {
                    return new URL(link.href)
                } catch {
                    return null
                }
            }

            function isSameOrigin(url) {
                return url && url.origin === location.origin
            }

            function shouldHandleLink(link) {

                if (link.target === "_blank") return false
                if (link.hasAttribute("download")) return false

                const url = getURL(link)

                if (!url) return false
                if (url.protocol === "mailto:" || url.protocol === "tel:") return false

                return isSameOrigin(url)
            }

            /*
            |--------------------------------------------------------------------------
            | VIEWPORT PREFETCH
            |--------------------------------------------------------------------------
            */

            const observer = new IntersectionObserver((entries) => {

                entries.forEach(entry => {

                    if (!entry.isIntersecting) return

                    const link = entry.target
                    const url = getURL(link)

                    if (!url) return

                    const key = url.pathname + url.search

                    if (PREFETCHED.has(key)) {
                        observer.unobserve(link)
                        return
                    }

                    PREFETCHED.add(key)
                    fetchPage(url)

                    observer.unobserve(link)
                })

            }, {
                rootMargin: "300px"
            })

            /*
            |--------------------------------------------------------------------------
            | INIT LINKS
            |--------------------------------------------------------------------------
            */

            document.addEventListener("DOMContentLoaded", () => {
                initLinks(document)
            })

            function initLinks(root) {

                const links = root.querySelectorAll("[prefetchlink]")

                links.forEach(link => {

                    if (!shouldHandleLink(link)) return

                    const url = getURL(link)
                    if (!url) return

                    const key = url.pathname + url.search

                    /*
                    |--------------------------------------------------------------
                    | VIEWPORT PREFETCH
                    |--------------------------------------------------------------
                    */

                    observer.observe(link)

                    /*
                    |--------------------------------------------------------------
                    | HOVER PREFETCH
                    |--------------------------------------------------------------
                    */

                    link.addEventListener("mouseenter", () => {

                        if (PREFETCHED.has(key)) return

                        PREFETCHED.add(key)
                        fetchPage(url)

                    }, { passive: true })

                    /*
                    |--------------------------------------------------------------
                    | CLICK NAVIGATION
                    |--------------------------------------------------------------
                    */

                    link.addEventListener("click", navigate)
                })
            }

            /*
            |--------------------------------------------------------------------------
            | FETCH PAGE
            |--------------------------------------------------------------------------
            */

            async function fetchPage(url) {

                const key = url.pathname + url.search

                if (PAGES_CACHE.has(key)) {
                    return PAGES_CACHE.get(key)
                }

                try {

                    const response = await fetch(url.href, {
                        headers: {
                            "X-Prefetch": "true"
                        }
                    })

                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`)
                    }

                    const html = await response.text()

                    PAGES_CACHE.set(key, html)

                    return html

                } catch (err) {

                    console.error("Prefetch error:", err)
                    return null
                }
            }

            /*
            |--------------------------------------------------------------------------
            | PAGE TRANSITION SWAP
            |--------------------------------------------------------------------------
            */

            function swapContent(newMain, currentMain) {

                const update = () => {
                    currentMain.innerHTML = newMain.innerHTML
                }

                if (supportsViewTransition) {

                    document.startViewTransition(() => {
                        update()
                    })

                } else {
                    update()
                }
            }

            /*
            |--------------------------------------------------------------------------
            | NAVIGATION
            |--------------------------------------------------------------------------
            */

            async function navigate(event) {

                event.preventDefault()

                if (window.__nprogress) window.__nprogress.start()

                const link = event.currentTarget
                const url = getURL(link)

                if (!url) {
                    if (window.__nprogress) window.__nprogress.done()
                    return
                }

                const key = url.pathname + url.search

                try {

                    let html = PAGES_CACHE.get(key)

                    if (!html) {
                        html = await fetchPage(url)
                    }

                    if (!html) {
                        if (window.__nprogress) window.__nprogress.done()
                        window.location.href = url.href
                        return
                    }

                    const parser = new DOMParser()
                    const doc = parser.parseFromString(html, "text/html")

                    const newMain = doc.querySelector("main")
                    const currentMain = document.querySelector("main")

                    if (!newMain || !currentMain) {
                        if (window.__nprogress) window.__nprogress.done()
                        window.location.href = url.href
                        return
                    }

                    /*
                    |--------------------------------------------------------------------------
                    | PAGE TRANSITION SWAP
                    |--------------------------------------------------------------------------
                    */

                    swapContent(newMain, currentMain)

                    /*
                    |--------------------------------------------------------------------------
                    | UPDATE STATE
                    |--------------------------------------------------------------------------
                    */

                    document.title = doc.title
                    history.pushState({}, "", url.href)

                    window.scrollTo({
                        top: 0,
                        behavior: "instant"
                    })

                    initLinks(document)

                    if (window.__nprogress) window.__nprogress.done()

                } catch (err) {

                    console.error("Navigation error:", err)
                    if (window.__nprogress) window.__nprogress.done()
                    window.location.href = url.href
                }
            }

            /*
            |--------------------------------------------------------------------------
            | POPSTATE
            |--------------------------------------------------------------------------
            */

            window.addEventListener("popstate", async () => {

                if (window.__nprogress) window.__nprogress.start()

                const url = new URL(location.href)
                const key = url.pathname + url.search

                let html = PAGES_CACHE.get(key)

                if (!html) {
                    html = await fetchPage(url)
                }

                if (!html) {
                    if (window.__nprogress) window.__nprogress.done()
                    return
                }

                const parser = new DOMParser()
                const doc = parser.parseFromString(html, "text/html")

                const newMain = doc.querySelector("main")
                const currentMain = document.querySelector("main")

                if (!newMain || !currentMain) {
                    if (window.__nprogress) window.__nprogress.done()
                    return
                }

                swapContent(newMain, currentMain)

                document.title = doc.title

                initLinks(document)

                if (window.__nprogress) window.__nprogress.done()
            })

        })()
</script__>