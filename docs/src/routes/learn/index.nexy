---
from "@/locales/routes/learn" import Learn
from "@components/sections/otherHero.nexy" import OtherHero 

l = Learn()
title  = l.title
description = l.description

---
<main class=" overflow-x-hidden">
<OtherHero
    title={{title}}
    description={{description}}
/>
<section class="border-t border-border border-dashed">
    <aside class="w-container py-16 space-y-6">
        <div>
            <ul class="flex gap-4 items-center">
                <li class="bg-foreground text-foreground-second px-4 py-1 rounded-full ">{{l.filter_all}}</li>
                <li>{{l.filter_marketing}}</li>
                <li>{{l.filter_platform_engineering}}</li>
                <li>{{l.filter_ai}}</li>
                <li>{{l.filter_web_app}}</li>
            </ul>
            <ul>

            </ul>
        </div>
        <hr class="opacity-10">
    </aside>
</section>
</main>
