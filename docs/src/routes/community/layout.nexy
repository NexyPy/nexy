---
from "@/locales/routes/community/layout" import HeroI18n, SidebarI18n
from "@components/sections/otherHero.nexy" import OtherHero

h = HeroI18n()
s = SidebarI18n()
title = h.title
description = h.description
children:prop[str]


---
<main class="overflow-x-hidden">
<OtherHero title={{title}} description={{description}} />
<main class="border-t border-border border-dashed">
    <section class="w-container mx-auto flex">
        <aside id="community-sidebar-desktop" class="w-72 py-12 px-6 border-r border-border border-dashed space-y-4 hidden lg:block">
            <h2 class="text-xs uppercase font-mono opacity-80">{{s.get_started}}</h2>
            <ul class="space-y-1.5 *:px-3 text-sm border-l border-border border-dashed">
                <li class=" ">
                    <a href="/community">{{s.get_help}}</a>
                </li>
                 <li>
                    <a href="/community/team">{{s.support}}</a>
                </li>
                 <li>
                    <a href="/community/governance">{{s.faq}}</a>
                </li>
            </ul>
            <h2 class="text-xs uppercase font-mono opacity-80">{{s.contribute}}</h2>
            <ul class="space-y-1.5 *:px-3 text-sm border-l border-border border-dashed">
                <li class="bg-green-600/20 border-l-2 py-1 text-base border-green-600  ">
                    <a href="/community">{{s.guide}}</a>
                </li>
                 <li>
                    <a href="/community/team">{{s.report_bug}}</a>
                </li>
                 <li>
                    <a href="/community/governance">{{s.feature_request}}</a>
                </li>
            </ul>
            <h2 class="text-xs uppercase font-mono opacity-80 mt-8">{{s.governance}}</h2>
            <ul class="space-y-1.5 *:px-3 text-sm border-l border-border border-dashed">
                <li class=" ">
                    <a href="/community">{{s.team}}</a>
                </li>
                 <li>
                    <a href="/community/team">{{s.roadmap}}</a>
                </li>
                 <li>
                    <a href="/community/governance">{{s.manifesto}}</a>
                </li>
            </ul>
        </aside>
        <aside class="p-12 flex-1">
            {{children}}
        </aside>
        <aside class="w-24 border-border border-dashed hidden lg:block"></aside>
    </section>
</main>
</main>

<button id="community-sidebar-toggle" class="lg:hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-20 flex items-center justify-center gap-2 w-[80%] max-w-md px-5 py-3 rounded-full bg-foreground text-white dark:text-gray-950 shadow-lg cursor-pointer hover:opacity-90 transition-all uppercase text-sm font-mono" onclick="toggleCommunitySidebar()">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/></svg>
    <span class="text-xs font-medium">Menu</span>
</button>

<div id="community-sidebar-modal" class="hidden fixed inset-0 z-40 items-end justify-center pb-4">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeCommunitySidebar()"></div>
    <div class="relative bg-background border border-border rounded-xl shadow-2xl w-full max-w-sm overflow-hidden max-h-[80vh] flex flex-col">
        <div class="flex items-center justify-between px-4 py-3 border-b border-border shrink-0">
            <span class="text-sm font-medium text-foreground">Community</span>
            <button onclick="closeCommunitySidebar()" class="p-1.5 hover:bg-muted rounded-md text-muted-foreground transition-colors cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="overflow-y-auto p-2 flex-1">
            <div class="p-4 space-y-4">
                <div>
                    <h2 class="text-xs uppercase font-mono opacity-80 mb-2">{{s.get_started}}</h2>
                    <ul class="space-y-1.5 *:px-3 text-sm border-l border-border">
                        <li><a href="/community" onclick="closeCommunitySidebar()">{{s.get_help}}</a></li>
                        <li><a href="/community/team" onclick="closeCommunitySidebar()">{{s.support}}</a></li>
                        <li><a href="/community/governance" onclick="closeCommunitySidebar()">{{s.faq}}</a></li>
                    </ul>
                </div>
                <div>
                    <h2 class="text-xs uppercase font-mono opacity-80 mb-2">{{s.contribute}}</h2>
                    <ul class="space-y-1.5 *:px-3 text-sm border-l border-border">
                        <li><a href="/community" onclick="closeCommunitySidebar()">{{s.guide}}</a></li>
                        <li><a href="/community/team" onclick="closeCommunitySidebar()">{{s.report_bug}}</a></li>
                        <li><a href="/community/governance" onclick="closeCommunitySidebar()">{{s.feature_request}}</a></li>
                    </ul>
                </div>
                <div>
                    <h2 class="text-xs uppercase font-mono opacity-80 mt-8 mb-2">{{s.governance}}</h2>
                    <ul class="space-y-1.5 *:px-3 text-sm border-l border-border">
                        <li><a href="/community" onclick="closeCommunitySidebar()">{{s.team}}</a></li>
                        <li><a href="/community/team" onclick="closeCommunitySidebar()">{{s.roadmap}}</a></li>
                        <li><a href="/community/governance" onclick="closeCommunitySidebar()">{{s.manifesto}}</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
function toggleCommunitySidebar() {
    document.getElementById('community-sidebar-modal').classList.remove('hidden');
    document.getElementById('community-sidebar-modal').classList.add('flex');
    document.body.style.overflow = 'hidden';
}
function closeCommunitySidebar() {
    document.getElementById('community-sidebar-modal').classList.add('hidden');
    document.getElementById('community-sidebar-modal').classList.remove('flex');
    document.body.style.overflow = '';
}
</script>