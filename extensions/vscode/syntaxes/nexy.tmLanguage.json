{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nexy",
  "scopeName": "source.nexy",
  "fileTypes": [
    "nexy"
  ],
  "patterns": [
    {
      "include": "#header"
    },
    {
      "include": "#template"
    }
  ],
  "repository": {
    
    "header": {
      "name": "meta.header.nexy",
      "begin": "^(---)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.header.begin.nexy"
        }
      },
      "end": "^(---)\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.header.end.nexy"
        }
      },
        "patterns": [
        { "include": "#python-import-from" },
        { "include": "#python-import-list" },
        { "include": "#python-assignment" },
        { "include": "#nexy-prop" },
        { "include": "#nexy-prop-decl" },
        { "include": "#py-dict-key" },
        { "include": "#py-triple-single" },
        { "include": "#py-triple-double" },
        { "include": "#py-string-double" },
        { "include": "#py-string-single" },
        { "include": "#py-fstring-double" },
        { "include": "#py-fstring-single" },
        { "include": "#py-number" },
        { "include": "#py-builtins" },
        { "include": "#py-keywords" },
        { "include": "#py-function-call" },
        { "include": "#py-op-comparison" },
        { "include": "#py-op-math" },
        { "include": "#py-identifier" },
        {
          "name": "keyword.control.import.python.fallback.nexy",
          "match": "\\b(import|from|as|with|def|class|return|True|False|None)\\b"
        }
      ]
    },
    "nexy-prop": {
      "name": "storage.type.nexy",
      "match": "\\bprop\\b"
    },
    "python-import-list": {
      "name": "meta.import.python.fallback.nexy",
      "begin": "^\\s*(import)\\s+",
      "beginCaptures": {
        "1": { "name": "keyword.control.import.python.fallback.nexy" }
      },
      "end": "$",
      "patterns": [
        {
          "match": "(?:\"[^\"]+\"|'[^']+'|[A-Za-z_][\\w.]*)",
          "name": "entity.name.namespace.python.nexy"
        },
        { "match": ",", "name": "punctuation.separator.comma.python.nexy" },
        {
          "match": "\\s+as\\s+",
          "name": "keyword.other.as.python.fallback.nexy"
        },
        { "match": "[A-Za-z_][\\w]*", "name": "variable.other.alias.python.nexy" }
      ]
    },
    "python-import-from": {
      "name": "meta.from-import.python.fallback.nexy",
      "begin": "^\\s*(from)\\s+",
      "beginCaptures": {
        "1": { "name": "keyword.control.import.python.fallback.nexy" }
      },
      "end": "$",
      "patterns": [
        {
          "match": "(?:[A-Za-z_][\\w.]*|\"[^\"]+\"|'[^']+')",
          "name": "entity.name.namespace.python.nexy"
        },
        {
          "match": "\\s+(import)\\s+",
          "captures": { "1": { "name": "keyword.control.import.python.fallback.nexy" } }
        },
        { "match": "[A-Za-z_][\\w]*", "name": "entity.name.imported.python.nexy" },
        { "match": ",", "name": "punctuation.separator.comma.python.nexy" },
        {
          "match": "\\s+as\\s+",
          "name": "keyword.other.as.python.fallback.nexy"
        },
        { "match": "[A-Za-z_][\\w]*", "name": "variable.other.alias.python.nexy" }
      ]
    },
    "python-assignment": {
      "name": "meta.assignment.python.fallback.nexy",
      "match": "^\\s*([A-Za-z_][\\w]*)\\s*(?::[^=]+)?\\s*(=)",
      "captures": {
        "1": { "name": "variable.other.readwrite.python.nexy" },
        "2": { "name": "keyword.operator.assignment.python.nexy" }
      }
    },
    "nexy-prop-decl": {
      "name": "meta.declaration.prop.nexy",
      "begin": "^\\s*([A-Za-z_][\\w]*)\\s*:\\s*(prop)(\\[)",
      "beginCaptures": {
        "1": { "name": "variable.other.readwrite.nexy" },
        "2": { "name": "storage.type.nexy" },
        "3": { "name": "punctuation.section.brackets.begin.nexy" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.section.brackets.end.nexy" }
      },
      "patterns": [
        { "match": "[^\\]]+", "name": "support.type.nexy" }
      ]
    },
    "py-dict-key": {
      "match": "(?<=\\{|\\,)\\s*(\"[^\"]*\"|'[^']*')\\s*(:)",
      "captures": {
        "1": { "name": "entity.other.attribute-name.python" },
        "2": { "name": "punctuation.separator.key-value.python" }
      }
    },
    "py-triple-single": {
      "name": "string.quoted.single.multiline.python",
      "begin": "'''",
      "end": "'''",
      "patterns": [
        { "match": "\\\\[\\s\\S]", "name": "constant.character.escape.python" },
        { "include": "#jinja-expression" },
        { "include": "#jinja-block" },
        { "include": "#jinja-comment" }
      ]
    },
    "py-triple-double": {
      "name": "string.quoted.double.multiline.python",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        { "match": "\\\\[\\s\\S]", "name": "constant.character.escape.python" },
        { "include": "#jinja-expression" },
        { "include": "#jinja-block" },
        { "include": "#jinja-comment" }
      ]
    },
    "py-string-single": {
      "name": "string.quoted.single.python",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "match": "\\\\[\\s\\S]", "name": "constant.character.escape.python" },
        { "include": "#jinja-expression" },
        { "include": "#jinja-block" },
        { "include": "#jinja-comment" }
      ]
    },
    "py-string-double": {
      "name": "string.quoted.double.python",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "match": "\\\\[\\s\\S]", "name": "constant.character.escape.python" },
        { "include": "#jinja-expression" },
        { "include": "#jinja-block" },
        { "include": "#jinja-comment" }
      ]
    },
    "py-fstring-single": {
      "name": "string.quoted.single.fstring.python",
      "begin": "f'",
      "end": "'",
      "patterns": [
        { "match": "\\\\[\\s\\S]", "name": "constant.character.escape.python" },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [ { "include": "#py-identifier" }, { "include": "#py-function-call" }, { "include": "#py-number" } ]
        },
        { "include": "#jinja-expression" },
        { "include": "#jinja-block" },
        { "include": "#jinja-comment" }
      ]
    },
    "py-fstring-double": {
      "name": "string.quoted.double.fstring.python",
      "begin": "f\"",
      "end": "\"",
      "patterns": [
        { "match": "\\\\[\\s\\S]", "name": "constant.character.escape.python" },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [ { "include": "#py-identifier" }, { "include": "#py-function-call" }, { "include": "#py-number" } ]
        },
        { "include": "#jinja-expression" },
        { "include": "#jinja-block" },
        { "include": "#jinja-comment" }
      ]
    },
    "py-number": {
      "match": "\\b(?:0[bBoOxX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric.python"
    },
    "py-builtins": {
      "match": "\\b(abs|all|any|bool|callable|dict|enumerate|float|int|len|list|max|min|print|range|set|str|sum|tuple|zip|type|isinstance|hasattr|getattr|setattr|delattr|super|object|property|staticmethod|classmethod|reversed|sorted|filter|map|open|file|input|iter|next|repr|id|ord|chr|hex|oct|bin|pow|round|hash|slice|vars|dir|locals|globals|__import__|compile|eval|exec|__file__|__name__|__doc__|__dict__)\\b",
      "name": "support.function.builtin.python"
    },
    "py-keywords": {
      "match": "\\b(and|or|not|is|in|as|if|else|elif|for|while|break|continue|return|yield|import|from|class|def|with|try|except|finally|raise|pass|del|global|nonlocal|lambda|assert|async|await|True|False|None)\\b",
      "name": "keyword.control.python"
    },
    "py-function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.python" }
      }
    },
    "py-op-comparison": {
      "match": "==|!=|<=|>=|<>|(?:\\bis\\b|\\bin\\b)",
      "name": "keyword.operator.comparison.python"
    },
    "py-op-math": {
      "match": "\\+|\\-|\\*|\\/|\\%|\\*\\*|\\/\\/|\\|\\||&&|\\||\\^|~|<<|>>|&|=|:",
      "name": "keyword.operator.arithmetic.python"
    },
    "py-identifier": {
      "match": "\\b[_A-Za-z][_A-Za-z0-9]*\\b",
      "name": "variable.other.readwrite.python"
    },
    "template": {
      "name": "meta.template.nexy",
      "begin": "(?<=^---)\\s*$|(?:^(?!---))",
      "end": "(?=^---\\s*$)",
      "patterns": [
        {
          "include": "#jinja-comment"
        },
        {
          "include": "#jinja-block"
        },
        {
          "include": "#jinja-expression"
        },
        {
          "include": "#style-tag"
        },
        {
          "include": "#script-tag"
        },
        {
          "include": "#component-tag-open"
        },
        {
          "include": "#custom-component"
        },
        {
          "include": "text.html.basic"
        }
      ]
    },
    "style-tag": {
      "begin": "(<)(style)(?:\\s+lang\\s*=\\s*[\"'](scss|sass|less|postcss)[\"'])?\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.html" },
        "3": { "name": "string.quoted.html" },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "begin": "(?<=<style\\s+lang=[\"']scss[\"']>)",
          "end": "(?=</style>)",
          "contentName": "source.css.scss",
          "include": "source.css.scss"
        },
        {
          "begin": "(?<=<style\\s+lang=[\"']sass[\"']>)",
          "end": "(?=</style>)",
          "contentName": "source.sass",
          "include": "source.sass"
        },
        {
          "begin": "(?<=<style\\s+lang=[\"']less[\"']>)",
          "end": "(?=</style>)",
          "contentName": "source.css.less",
          "include": "source.css.less"
        },
        {
          "begin": "(?<=<style\\s+lang=[\"']postcss[\"']>)",
          "end": "(?=</style>)",
          "contentName": "source.css.postcss",
          "include": "source.css"
        },
        {
          "begin": "(?<=<style>)",
          "end": "(?=</style>)",
          "contentName": "source.css",
          "include": "source.css"
        },
        { "include": "source.css" }
      ]
    },
    "script-tag": {
      "begin": "(<)(script)(?:\\s+lang\\s*=\\s*[\"'](ts|tsx|jsx|rust)[\"'])?\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" },
        "3": { "name": "string.quoted.html" },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(script)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "begin": "(?<=<script\\s+lang=[\"']ts[\"']>)",
          "end": "(?=</script>)",
          "contentName": "source.ts",
          "include": "source.ts"
        },
        {
          "begin": "(?<=<script\\s+lang=[\"']tsx[\"']>)",
          "end": "(?=</script>)",
          "contentName": "source.tsx",
          "include": "source.tsx"
        },
        {
          "begin": "(?<=<script\\s+lang=[\"']jsx[\"']>)",
          "end": "(?=</script>)",
          "contentName": "source.jsx",
          "include": "source.jsx"
        },
        {
          "begin": "(?<=<script\\s+lang=[\"']rust[\"']>)",
          "end": "(?=</script>)",
          "contentName": "source.rust",
          "include": "source.rust"
        },
        {
          "begin": "(?<=<script>)",
          "end": "(?=</script>)",
          "contentName": "source.js",
          "include": "source.js"
        },
        { "include": "source.js" }
      ]
    },
    "jinja-expression": {
      "name": "meta.embedded.jinja.expression.nexy",
      "begin": "\\{\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.jinja2"
        }
      },
      "end": "\\}\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.jinja2"
        }
      },
      "patterns": [
        {
          "match": "\\|\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "support.function.jinja2.nexy" }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.separator.period.python" },
            "2": { "name": "variable.other.object.property.python" }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.separator.period.python" },
            "2": { "name": "variable.other.object.property.python" }
          }
        },
        {
          "match": "\\b(True|False|None|not|and|or|in|is|as)\\b",
          "name": "keyword.control.python"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.python" }
          }
        },
        { "include": "#py-string-single" },
        { "include": "#py-string-double" },
        { "include": "#py-fstring-single" },
        { "include": "#py-fstring-double" },
        { "include": "#py-number" },
        { "include": "#py-builtins" },
        { "include": "#py-op-comparison" },
        { "include": "#py-op-math" },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
          "name": "variable.other.readwrite.python"
        }
      ]
    },
    "jinja-block": {
      "name": "meta.embedded.jinja.block.nexy",
      "begin": "\\{%[-]?",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-block.begin.jinja2"
        }
      },
      "end": "[-]?%\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-block.end.jinja2"
        }
      },
      "patterns": [
        {
          "match": "\\b(if|elif|else|for|not|and|or|in|is|as|import|from|True|False|None)\\b",
          "name": "keyword.control.python"
        },
        {
          "match": "\\b(endif|endfor|endblock|endmacro|endcall|endfilter|endwith|endraw|block|extends|include|macro|call|filter|set|del|raw|with|without|context)\\b",
          "name": "keyword.control.python"
        },
        {
          "match": "\\|\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "support.function.jinja2.nexy" }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.separator.period.python" },
            "2": { "name": "variable.other.object.property.python" }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.separator.period.python" },
            "2": { "name": "variable.other.object.property.python" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.python" }
          }
        },
        { "include": "#py-string-single" },
        { "include": "#py-string-double" },
        { "include": "#py-fstring-single" },
        { "include": "#py-fstring-double" },
        { "include": "#py-number" },
        { "include": "#py-builtins" },
        { "include": "#py-op-comparison" },
        { "include": "#py-op-math" },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
          "name": "variable.other.readwrite.python"
        }
      ]
    },
    "jinja-comment": {
      "name": "comment.block.jinja2.nexy",
      "begin": "\\{#",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.jinja2"
        }
      },
      "end": "#\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.jinja2"
        }
      }
    },
    "component-tag-open": {
      "name": "meta.tag.component.start.nexy",
      "begin": "(<)([A-Z][A-Za-z0-9]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "support.class.component.html" }
      },
      "end": "(\\/?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        { "include": "#component-attributes" },
        { "include": "#jinja-expression" }
      ]
    },
    "component-attributes": {
      "name": "meta.tag.attributes.nexy",
      "patterns": [
        {
          "name": "entity.other.attribute-name.html",
          "match": "(?<=\\s)([@:\\w][\\w:.-]*)(?=\\s*=|\\s|\\/?>)"
        },
        {
          "name": "keyword.operator.assignment.html",
          "match": "="
        },
        {
          "name": "string.quoted.double.html",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "match": "\\\\.", "name": "constant.character.escape.html" },
            { "include": "#jinja-expression" },
            { "include": "#jinja-block" },
            { "include": "#jinja-comment" }
          ]
        },
        {
          "name": "string.quoted.single.html",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "match": "\\\\.", "name": "constant.character.escape.html" },
            { "include": "#jinja-expression" },
            { "include": "#jinja-block" },
            { "include": "#jinja-comment" }
          ]
        },
        {
          "name": "constant.language.boolean.html",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.html",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        },
        {
          "name": "variable.other.attribute.unquoted.html",
          "match": "(?<=\\=)(?![\"'])([^\\s>]+)"
        }
      ]
    },
    "custom-component": {
      "name": "meta.tag.component.end.nexy",
      "match": "(</)([A-Z][A-Za-z0-9]*)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "support.class.component.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      }
    }
  }
}
