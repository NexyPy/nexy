{
  "name": "nexy",
  "displayName": "nexy",
  "description": "Syntax highlighting and basic language configuration for Nexy (.nexy) files",
  "icon": "fileicons/nexy.png",
  "license": "MIT",
  "version": "0.0.19",
  "publisher": "nexy",
  "repository": {
    "type": "git",
    "url": "https://github.com/NexyPy/nexy.git"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:nexy",
    "onLanguage:mdx"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nexy",
        "aliases": [
          "Nexy",
          "nexy"
        ],
        "extensions": [
          ".nexy"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "mdx",
        "aliases": [
          "MDX",
          "mdx"
        ],
        "extensions": [
          ".mdx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "iconThemes": [
      {
        "id": "nexy-icons",
        "label": "Nexy Icons",
        "path": "./fileicons/nexy-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "nexy",
        "scopeName": "source.nexy",
        "path": "./syntaxes/nexy.tmLanguage.json"
      },
      {
        "language": "mdx",
        "scopeName": "source.mdx",
        "path": "./syntaxes/mdx.tmLanguage.json"
      },
      {
        "scopeName": "jinja2.injection.nexy",
        "path": "./syntaxes/jinja2-injection.json",
        "injectTo": [
          "text.html.basic",
          "string.quoted.double.html",
          "string.quoted.single.html"
        ]
      }
    ],
    "snippets": [
      {
        "language": "nexy",
        "path": "./nexy.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "nexy.createComponent",
        "title": "Nexy: Create component",
        "category": "Nexy"
      },
      {
        "command": "nexy.insertHeader",
        "title": "Nexy: Insert header",
        "category": "Nexy"
      },
      {
        "command": "nexy.wrapWithComponent",
        "title": "Nexy: Wrap with component",
        "category": "Nexy"
      },
      {
        "command": "nexy.openDocs",
        "title": "Nexy: Open documentation",
        "category": "Nexy"
      },
      {
        "command": "nexy.restartLSP",
        "title": "Nexy: Restart language server",
        "category": "Nexy"
      },
      {
        "command": "nexy.toggleComment",
        "title": "Nexy: Toggle comment (header: #, template: {# #})",
        "category": "Nexy"
      }
    ],
    "configuration": {
      "title": "Nexy",
      "properties": {
        "nexy.decorations.enableFrameworkColors": {
          "type": "boolean",
          "default": true,
          "description": "Color Nexy components based on their framework (Vue, Nexy, React, Svelte)."
        },
        "nexy.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Nexy summary (section, props, imports) in status bar."
        }
      }
    },
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "nexy": "html",
        "mdx": "html"
      },
      "tailwindCSS.includeLanguages": {
        "nexy": "html",
        "mdx": "html"
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "punctuation.definition.header.begin.nexy",
              "punctuation.definition.header.end.nexy"
            ],
            "settings": {
              "foreground": "#444444",
              "fontStyle": "italic"
            }
          },
          {
            "scope": [
              "punctuation.definition.template-block.begin.jinja2",
              "punctuation.definition.template-block.end.jinja2"
            ],
            "settings": {
              "foreground": "#433f20"
            }
          },
          {
            "scope": [
              "punctuation.definition.template-expression.begin.jinja2",
              "punctuation.definition.template-expression.end.jinja2",
              "punctuation.definition.comment.begin.jinja2",
              "punctuation.definition.comment.end.jinja2"
            ],
            "settings": {
              "foreground": "#555555"
            }
          },
          {
            "scope": [
              "storage.type.nexy"
            ],
            "settings": {
              "foreground": "#ffa500"
            }
          },
          {
            "scope": [
              "variable.other.readwrite.python.nexy",
              "variable.other.readwrite.nexy",
              "variable.other.readwrite.fallback.nexy"
            ],
            "settings": {
              "foreground": "#E5C07B"
            }
          },
          {
            "scope": [
              "support.type.nexy"
            ],
            "settings": {
              "foreground": "#56B6C2"
            }
          },
          {
            "scope": [
              "keyword.operator.assignment.python.nexy"
            ],
            "settings": {
              "foreground": "#D19A66"
            }
          },
          {
            "scope": [
              "entity.name.namespace.python.nexy",
              "entity.name.imported.python.nexy",
              "variable.other.readwrite.python.nexy"
            ],
            "settings": {
              "foreground": "#4FC1FF"
            }
          }
        ]
      }
    },
    "keybindings": [
      {
        "command": "-editor.action.commentLine",
        "key": "ctrl+/",
        "when": "editorLangId == nexy && editorTextFocus"
      },
      {
        "command": "nexy.toggleComment",
        "key": "ctrl+/",
        "when": "editorLangId == nexy && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run check-types && node esbuild.js --production",
    "compile": "pnpm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@vscode/vsce": "^3.9.1",
    "vscode-html-languageservice": "^5.3.1",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.1.8"
  }
}
