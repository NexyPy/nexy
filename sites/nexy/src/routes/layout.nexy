---
from "@/components/Header.nexy" import Header
from "@/components/MobileBar.nexy" import MobileBar
from "@/components/SearchDialog.nexy" import SearchDialog
from "@/components/Sidebar.nexy" import Sidebar
from nexy import usePathname
from src.content import head_of, router_of, slug_of, title_of

children: prop[NexyElement]
current = slug_of(usePathname())
title = title_of(current)
head = head_of(current)
router = router_of(current)
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0a0a0a">
  {% if router %}<meta name="nexy-router" content="{{ router }}">{% endif %}
  <title>{{ title | e }}</title>
  {{ head | safe }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500..700&family=Geist:wght@400..600&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/style.css">
  <script>
    try {
      var saved = localStorage.getItem("nexy-docs-theme");
      var dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = dark ? "dark" : "light";
    } catch (e) { document.documentElement.dataset.theme = "light"; }
    // The menu starts folded when the reader folded it last time.
    try {
      if (localStorage.getItem("nexy-docs-side") === "closed") document.documentElement.dataset.side = "closed";
    } catch (e) {}
    // The routing groups of one router: the page's own, else the one chosen last, else FBR.
    try {
      var own = document.querySelector('meta[name="nexy-router"]');
      document.documentElement.dataset.router =
        (own && own.content) || localStorage.getItem("nexy-docs-router") || "fbr";
    } catch (e) { document.documentElement.dataset.router = "fbr"; }
    // The pages this browser has already read: read before the menu is painted, never after.
    try {
      document.documentElement.dataset.seen = localStorage.getItem("nexy-docs-seen") || "";
    } catch (e) {}
  </script>
</head>
<body data-root="" data-search="/search-index"{% if current == "" %} data-home="true"{% endif %}>
<a class="skip" href="#content">Skip to content</a>
<div class="shell">
  <MobileBar />
  <Sidebar current="{{ current }}" />
  <script>
    // The menu is dimmed as it is parsed, before the browser shows it: a page this browser has
    // already read never paints bright and then fades, and a reader without JS sees every link.
    try {
      var read = (document.documentElement.dataset.seen || "").split(",");
      var slugOf = function (path) {
        var parts = path.split("/").filter(Boolean);
        var at = parts.indexOf("docs");
        return at < 0 ? "" : parts.slice(at + 1).join("/");
      };
      document.querySelectorAll(".side .group a").forEach(function (link) {
        if (read.indexOf(slugOf(link.pathname)) >= 0) link.classList.add("seen");
      });
    } catch (e) {}
  </script>
  <div class="panel">
    <Header />
    <div class="panel-body">
      {{ children }}
    </div>
  </div>
</div>
<SearchDialog />
<script src="/assets/site.js" defer></script>
</body>
</html>
