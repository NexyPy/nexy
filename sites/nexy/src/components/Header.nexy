---
from src.content import ICONS
---
<header class="panel-bar">
  <button class="side-toggle bar-open" type="button" aria-label="Open the menu" aria-expanded="false">{{ ICONS.icon_sidebar }}</button>
  <span class="progress" aria-hidden="true"></span>
  <button class="bar-link search-open" type="button" aria-label="Search the docs">{{ ICONS.icon_search }}</button>
  <a class="bar-link" href="https://github.com/NexyPy/nexy" target="_blank" rel="noopener noreferrer" aria-label="Nexy on GitHub">{{ ICONS.icon_github }}</a>
  <button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Switch between light and dark" data-theme-toggle>
    <span class="theme-knob">{{ ICONS.icon_sun }}{{ ICONS.icon_moon }}</span>
  </button>
</header>
