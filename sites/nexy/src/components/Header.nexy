---
from src.content import ICONS, MARK, link
---
<header class="top">
  <button class="icon-button menu" aria-label="Open the menu" aria-expanded="false">{{ ICONS.icon_menu }}</button>
  <a class="brand" href="/docs">
    <span class="logo" aria-hidden="true">{{ MARK }}</span><span class="name">Nexy</span><span class="tag">Docs</span>
  </a>
  <nav class="top-nav" aria-label="Sections">
    <a href="{{ link('getting-started/quick-start') }}">Start</a>
    <a href="{{ link('routing/fbr/pages') }}">Build</a>
    <a href="{{ link('routing') }}">Choose</a>
    <a href="{{ link('reference/cli') }}">Reference</a>
  </nav>
  <span class="spacer"></span>
  <button class="search-open" aria-label="Search the docs">
    {{ ICONS.icon_search }}<span>Search the docs</span><kbd>Ctrl K</kbd>
  </button>
  <a class="icon-button" href="https://github.com/NexyPy/nexy" aria-label="Nexy on GitHub">{{ ICONS.icon_github }}</a>
  <button class="icon-button theme" type="button" role="switch" aria-checked="false" aria-label="Switch between light and dark" data-theme-toggle>{{ ICONS.icon_sun }}{{ ICONS.icon_moon }}</button>
  <span class="progress" aria-hidden="true"></span>
</header>
