---
from src.content import ICONS, area_select, menu

current: prop[str] = ""
groups = menu(current)
select = area_select(current)
---
<nav class="side" aria-label="Documentation">
  <div class="side-head">
    <span class="side-kicker">Documentation</span>
    <span class="side-version">2.2</span>
  </div>
  <label class="side-filter">
    {{ ICONS.icon_search }}
    <input type="search" placeholder="Filter pages" aria-label="Filter pages" autocomplete="off">
  </label>
  <details class="area-select" aria-label="Documentation area">
    <summary>
      <span class="area-icon">{{ select.shown.icon }}</span>
      <span class="area-text"><b>{{ select.shown.label | e }}</b><small>{{ select.shown.blurb | e }}</small></span>
      {{ ICONS.icon_select }}
    </summary>
    <ul>
      {% for area in select.choices %}
      <li><a href="{{ area.home }}"{% if area.current %} aria-current="true"{% endif %}>
        <span class="area-icon">{{ area.icon }}</span>
        <span class="area-text"><b>{{ area.label | e }}</b><small>{{ area.blurb | e }}</small></span>
        {{ ICONS.icon_check }}
      </a></li>
      {% endfor %}
    </ul>
  </details>
  {% for group in groups %}
  <details class="group" data-section="{{ group.title | e }}"{% if group.open %} open{% endif %}>
    <summary>
      <span class="group-name">{{ group.title | e }}</span>
      <span class="group-count">{{ group.count }}</span>
      {{ ICONS.icon_chev }}
    </summary>
    <ul>
      {% for page in group.pages %}
      <li>{% if page.current %}<a href="{{ page.href }}" aria-current="page">{{ page.label | e }}</a>{% else %}<a href="{{ page.href }}">{{ page.label | e }}</a>{% endif %}</li>
      {% endfor %}
    </ul>
  </details>
  {% endfor %}
  <p class="side-empty" hidden>No page matches.</p>
  <div class="side-foot">
    <a href="https://github.com/NexyPy/nexy">Source on GitHub</a>
    <a href="https://github.com/NexyPy/nexy/blob/main/llms.txt">llms.txt for agents</a>
  </div>
</nav>
