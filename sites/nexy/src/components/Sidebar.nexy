---
from src.content import ICONS, menu, routers

current: prop[str] = ""
groups = menu(current)
choices = routers()
---
<nav class="side" aria-label="Documentation">
  <div class="side-head">
    <span class="side-kicker">Documentation</span>
    <span class="side-version">2.2</span>
  </div>
  <label class="side-filter">
    {{ ICONS.icon_search }}
    <input type="search" placeholder="Filter pages" aria-label="Filter pages" autocomplete="off">
  </label>
  <div class="router-switch" role="group" aria-label="Router">
    <span>Docs for</span>
    {% for choice in choices %}<button type="button" data-router="{{ choice.id }}" data-home="{{ choice.home }}" aria-pressed="false">{{ choice.label | e }}</button>{% endfor %}
  </div>
  {% for group in groups %}
  <details class="group" data-section="{{ group.title | e }}" open>
    <summary>
      <span class="group-name">{{ group.title | e }}</span>
      <span class="group-rule" aria-hidden="true"></span>
      <span class="group-count">{{ group.count }}</span>
      {{ ICONS.icon_chev }}
    </summary>
    <ul>
      {% for page in group.pages %}
      {% if page.router %}<li data-router="{{ page.router }}">{% else %}<li>{% endif %}{% if page.current %}<a href="{{ page.href }}" aria-current="page">{{ page.label | e }}</a>{% else %}<a href="{{ page.href }}">{{ page.label | e }}</a>{% endif %}</li>
      {% endfor %}
    </ul>
  </details>
  {% endfor %}
  <p class="side-empty" hidden>No page matches.</p>
  <div class="side-foot">
    <a href="https://github.com/NexyPy/nexy">Source on GitHub</a>
    <a href="https://github.com/NexyPy/nexy/blob/main/llms.txt">llms.txt for agents</a>
  </div>
</nav>
