---
from src.content import ICONS, VERSION, home_link, language_select, menu, router_select

current: prop[str] = ""
sections = menu(current)
routers = router_select(current)
---
<nav class="side" aria-label="Documentation" data-i18n-aria="nav_aria">
  <div class="side-top">
    <div class="sheet-bar">
      <a class="bar-link" href="https://github.com/NexyPy/nexy" target="_blank" rel="noopener noreferrer" aria-label="Nexy on GitHub" data-i18n-aria="github_aria">{{ ICONS.icon_github }}</a>
      {{ language_select(current) }}
      <button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Switch between light and dark" data-i18n-aria="theme" data-theme-toggle>
        <span class="theme-knob">{{ ICONS.icon_sun }}{{ ICONS.icon_moon }}</span>
      </button>
      <button class="side-close" type="button" aria-label="Close the menu" data-i18n-aria="close_menu">{{ ICONS.icon_sidebar }}</button>
    </div>
    <div class="side-brand">
      <a class="brand" href="{{ home_link(current) }}" aria-label="Nexy, home" data-i18n-aria="home_aria">
        <img class="brand-logo" src="/assets/nexy.svg" alt="Nexy">
      </a>
      <span class="side-version" aria-label="Nexy {{ VERSION }}">{{ VERSION }}</span>
      <button class="side-toggle" type="button" aria-label="Collapse the menu" aria-expanded="true" data-i18n-aria="collapse_menu">{{ ICONS.icon_sidebar }}</button>
    </div>
    <details class="area-select" aria-label="Router" data-i18n-aria="router_aria">
      <summary>
        {% for router in routers %}
        <span class="area-face" data-router="{{ router.key }}">
          <span class="area-icon">{{ router.icon }}</span>
          <span class="area-text"><b data-i18n="{{ router.word }}">{{ router.name | e }}</b></span>
        </span>
        {% endfor %}
        {{ ICONS.icon_select }}
      </summary>
      <ul>
        {% for router in routers %}
        <li><a href="{{ router.home }}" data-pick="{{ router.key }}"{% if router.current %} aria-current="true"{% endif %}>
          <span class="area-icon">{{ router.icon }}</span>
          <span class="area-text"><b data-i18n="{{ router.word }}">{{ router.name | e }}</b></span>
          {{ ICONS.icon_check }}
        </a></li>
        {% endfor %}
      </ul>
    </details>
    <label class="side-filter">
      {{ ICONS.icon_search }}
      <input type="search" placeholder="Filter pages" aria-label="Filter pages" data-i18n-placeholder="filter" data-i18n-aria="filter" autocomplete="off">
    </label>
  </div>
  <div class="side-scroll">
    {% for section in sections %}
    <div class="side-part">
      <p class="side-section">{{ section.label | e }}</p>
      {% for group in section.groups %}
      <details class="group" data-section="{{ group.title | e }}" data-scope="{{ group.scope }}"{% if group.router %} data-router="{{ group.router }}"{% endif %}{% if group.open %} open{% endif %}>
        <summary>
          <span class="group-name">{{ group.title | e }}</span>
          {{ ICONS.icon_chev }}
        </summary>
        <ul>
          {% for page in group.pages %}
          <li><a href="{{ page.href }}"{% if page.current %} aria-current="page"{% endif %}>{{ page.label | e }}</a>{% if page.badge %}<span class="badge-new" data-i18n="new_badge">New</span>{% endif %}</li>
          {% endfor %}
        </ul>
      </details>
      {% endfor %}
    </div>
    {% endfor %}
    <p class="side-empty" data-i18n="no_match" hidden>No page matches.</p>
    <div class="side-foot">
      <a href="#" class="continue" hidden>Continue</a>
      <a href="#" class="all-docs" data-i18n="all_docs">All documentation</a>
      <a href="https://github.com/NexyPy/nexy" data-i18n="source_github">Source on GitHub</a>
      <a href="https://github.com/NexyPy/nexy/blob/main/llms.txt" data-i18n="llms">llms.txt for agents</a>
    </div>
  </div>
</nav>
