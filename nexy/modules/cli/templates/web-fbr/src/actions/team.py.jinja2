"""The two actions the /connection page calls: the team lives on the Python server.

`team` lists it and `join_team` adds a member. Each one is a POST endpoint, typed in
`@nexy/actions`, so the page calls them like functions.
"""

from pydantic import BaseModel

from nexy.decorators import Action
{%- if orm == "Tortoise-ORM" %}
from src.configs.db import arun
{%- endif %}
{%- if orm != "None" %}
from src.services.user_service import UserService
{%- endif %}


class Member(BaseModel):
    name: str
    email: str


class Team(BaseModel):
    members: list[Member]
    note: str = ""  # why the last member was not added; empty when it was


def _problem(name: str, email: str, members: list[Member]) -> str:
    """What is wrong with a new member, or an empty string."""
    if not name:
        return "Write a name."
    if "@" not in email:
        return "Write an email address."
    if any(member.email == email for member in members):
        return f"{email} is already on the team."
    return ""
{% if orm == "None" %}

# No database in this project: the team is a list of dictionaries the server keeps while it runs.
TEAM: list[dict[str, str]] = [
    {"name": "Ada Lovelace", "email": "ada@example.com"},
    {"name": "Grace Hopper", "email": "grace@example.com"},
    {"name": "Alan Turing", "email": "alan@example.com"},
]


def _members() -> list[Member]:
    return [Member(**person) for person in TEAM]


@Action
def team() -> Team:
    """Everyone on the team."""
    return Team(members=_members())


@Action
def join_team(name: str, email: str) -> Team:
    """Add a member, then answer with the whole team."""
    name, email = name.strip(), email.strip().lower()
    note = _problem(name, email, _members())
    if not note:
        TEAM.append({"name": name, "email": email})
    return Team(members=_members(), note=note)
{% elif orm == "Tortoise-ORM" %}

# The team is the `users` table of the database in `.env` (DATABASE_URL). Tortoise runs on a loop
# of its own (src/configs/db.py): `arun` waits for it without blocking the server.


async def _members() -> list[Member]:
    users = await arun(UserService.get_all())
    return [Member(name=user.name, email=user.email) for user in users]


@Action
async def team() -> Team:
    """Everyone on the team, read from the database."""
    return Team(members=await _members())


@Action
async def join_team(name: str, email: str) -> Team:
    """Add a member to the database, then answer with the whole team."""
    name, email = name.strip(), email.strip().lower()
    note = _problem(name, email, await _members())
    if not note:
        await arun(UserService.create(name, email))
    return Team(members=await _members(), note=note)
{% else %}

# The team is the `users` table of the database in `.env` (DATABASE_URL). The actions are plain
# functions: Nexy runs them in a thread, so a query never holds up the other requests.


def _members() -> list[Member]:
    return [Member(name=user.name, email=user.email) for user in UserService.get_all()]


@Action
def team() -> Team:
    """Everyone on the team, read from the database."""
    return Team(members=_members())


@Action
def join_team(name: str, email: str) -> Team:
    """Add a member to the database, then answer with the whole team."""
    name, email = name.strip(), email.strip().lower()
    note = _problem(name, email, _members())
    if not note:
        UserService.create(name, email)
    return Team(members=_members(), note=note)
{% endif %}
