"""The action the /connection page calls: its answer proves Python is reached."""

import platform
from datetime import UTC, datetime

from pydantic import BaseModel

from nexy.decorators import Action


class Pong(BaseModel):
    python: str
    time: str


@Action
async def ping() -> Pong:
    """The Python version of the server and its clock, in UTC."""
    now = datetime.now(UTC).strftime("%H:%M:%S UTC")
    return Pong(python=platform.python_version(), time=now)
