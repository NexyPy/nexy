{% if not utility_ui %}{% if not useCSR %}{% raw %}---
from "@/components/header.nexy" import Header
from "@/components/footer.nexy" import Footer
from nexy import Vite

children:prop[NexyElement]
---
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Built with Nexy">
    <title>Nexy App</title>
    <style>{% endraw %}{% include "critical.css" %}{% raw %}</style>
    <script>{% endraw %}{% include "theme_script.js" %}{% raw %}</script>
    <Vite />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..700&family=Geist:wght@400..600&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">
</head>

<body class="nx-page">
    <Header />
    <main class="nx-main">
        {{children | safe}}
    </main>
    <Footer />
</body>

</html>
{% endraw %}{% endif %}{% endif %}
