{% if useCSR %}{% raw %}---
from nexy import Vite

children:prop[NexyElement]
---
<!DOCTYPE html>
<html lang="{{ locale }}" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Built with Nexy">
    <title>Nexy App</title>
    <Vite />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@400..600&family=Inter:wght@100..900&display=swap" rel="stylesheet">
    <script>
        document.documentElement.classList.toggle(
            "dark",
            localStorage.getItem("nexy-theme") === "dark" ||
            (!("nexy-theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches),
        );
    </script>
</head>

<body class="antialiased min-h-dvh flex flex-col bg-background text-foreground">
    <header class="sticky top-0 z-30 bg-background/80 backdrop-blur border-b border-dashed border-border">
        <nav class="w-container flex items-center justify-between gap-6 px-6 md:px-10 py-4">
            <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
                <span class="size-2.5 rounded-full bg-accent"></span>
                Nexy
            </a>
            <a href="https://github.com/NexyPy/nexy" target="_blank" rel="noopener noreferrer"
                class="eyebrow hover:text-foreground ease">
                GitHub &#8599;
            </a>
        </nav>
    </header>
    <main class="flex-1 flex flex-col">
        {{children | safe}}
    </main>
    <footer class="border-t border-dashed border-border">
        <div class="w-container px-6 md:px-10 py-6 flex items-center justify-between gap-4">
            <p class="eyebrow">Built with Nexy</p>
            <p class="eyebrow">MIT</p>
        </div>
    </footer>
</body>

</html>
{% endraw %}{% else %}{% raw %}---
from "@/components/header.nexy" import Header
from "@/components/footer.nexy" import Footer
