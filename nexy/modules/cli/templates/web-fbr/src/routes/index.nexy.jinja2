{% if not useCSR %}---
{% if client_framework == "none" %}
from "@/components/vanillaCard.nexy" import VanillaCard
{% elif client_framework == "vue" %}
from "@/components/card.vue" import Card as FrameworkCard
{% elif client_framework == "svelte" %}
from "@/components/card.svelte" import Card as FrameworkCard
{% else %}
from "@/components/card.tsx" import Card as FrameworkCard
{% endif %}
---
{% set fw_label = {"none": "HTML", "vue": "Vue", "svelte": "Svelte", "preact": "Preact", "solid": "Solid", "react": "React"}.get(client_framework, "React") %}
<section class="relative isolate overflow-hidden">
    <div class="bg-glow absolute inset-0 -z-10"></div>
    <div class="bg-grid absolute inset-0 -z-10"></div>

    <div class="w-container px-6 md:px-10 py-16 md:py-24 flex flex-col lg:flex-row items-center gap-14 lg:gap-20">
        <div class="flex-1 flex flex-col items-center lg:items-start text-center lg:text-left gap-6">
            <p class="eyebrow inline-flex items-center gap-2 rounded-full border border-dashed border-border px-3 py-1">
                <span class="size-1.5 rounded-full bg-accent"></span>
                Nexy &times; {{ fw_label }}
            </p>
            <h1 class="text-4xl md:text-6xl leading-[1.05]">
                Your app is live.<br>
                <span class="text-accent">Start building.</span>
            </h1>
            <p class="max-w-md text-foreground/60 leading-7">
                Edit
                <code class="font-mono text-sm rounded-md border border-border bg-background-second/10 px-1.5 py-0.5">src/routes/index.nexy</code>
                and save. Layouts in <code class="font-mono text-sm">layout.nexy</code> wrap every page below them.
            </p>
            <div class="flex flex-wrap justify-center lg:justify-start gap-3">
                <a href="https://github.com/NexyPy/nexy" target="_blank" rel="noopener noreferrer"
                    class="ease rounded-full bg-foreground text-background px-5 py-2 text-sm font-medium hover:opacity-85">
                    Read the docs
                </a>
                <a href="https://github.com/NexyPy/nexy" target="_blank" rel="noopener noreferrer"
                    class="ease rounded-full border border-border px-5 py-2 text-sm font-medium hover:border-accent hover:text-accent">
                    Star on GitHub
                </a>
            </div>
        </div>

        <div class="dark w-full max-w-sm rounded-3xl bg-background border border-dashed border-border p-3">
{% if client_framework == "none" %}
            <VanillaCard />
{% else %}
            <FrameworkCard />
{% endif %}
        </div>
    </div>

    <div class="w-container px-6 md:px-10 pb-16 md:pb-24 grid gap-4 md:grid-cols-3">
        <a href="https://github.com/NexyPy/nexy" target="_blank" rel="noopener noreferrer"
            class="ease group rounded-2xl border border-border bg-background-second/5 p-5 hover:border-accent hover:border-dashed">
            <p class="eyebrow group-hover:text-accent ease">Documentation &#8599;</p>
            <p class="mt-3 text-sm text-foreground/60 leading-6">Routing, layouts and hybrid rendering, explained.</p>
        </a>
        <a href="https://github.com/NexyPy/nexy" target="_blank" rel="noopener noreferrer"
            class="ease group rounded-2xl border border-border bg-background-second/5 p-5 hover:border-accent hover:border-dashed">
            <p class="eyebrow group-hover:text-accent ease">Community &#8599;</p>
            <p class="mt-3 text-sm text-foreground/60 leading-6">Browse the source, suggest features, open your first PR.</p>
        </a>
        <div class="rounded-2xl border border-dashed border-border p-5">
            <p class="eyebrow">Layouts</p>
            <p class="mt-3 text-sm text-foreground/60 leading-6">The root layout owns <code class="font-mono">&lt;html&gt;</code>; nested <code class="font-mono">layout.nexy</code> files inherit it.</p>
        </div>
    </div>
</section>
{% endif %}
