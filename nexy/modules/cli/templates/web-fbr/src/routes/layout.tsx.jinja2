{%- if useCSR and client_framework in ["react", "solid", "preact"] -%}
{%- set charset_attr = "charSet" if client_framework == "react" else "charset" -%}
{%- set cross_attr = "crossOrigin" if client_framework == "react" else "crossorigin" -%}
{%- if client_framework == "react" -%}
import type { ReactNode } from "react";
{%- elif client_framework == "solid" -%}
import type { JSX } from "solid-js";
{%- else -%}
import type { ComponentChildren } from "preact";
{%- endif %}

const themeScript = `
  document.documentElement.classList.toggle(
    "dark",
    localStorage.getItem("nexy-theme") === "dark" ||
      (!("nexy-theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches),
  );
`;

{% if client_framework == "solid" -%}
export default function RootLayout(props: { children: JSX.Element }) {
{%- elif client_framework == "react" -%}
export default function RootLayout({ children }: { children: ReactNode }) {
{%- else -%}
export default function RootLayout({ children }: { children: ComponentChildren }) {
{%- endif %}
  return (
    <html lang="en" {{ cls }}="dark"{% if client_framework == "react" %} suppressHydrationWarning{% endif %}>
      <head>
        <meta {{ charset_attr }}="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="Built with Nexy" />
        <title>Nexy App</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" {{ cross_attr }}="" />
        <link
          href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@400..600&family=Inter:wght@100..900&display=swap"
          rel="stylesheet"
        />
{% if client_framework == "solid" -%}
        <script innerHTML={themeScript} />
{%- else -%}
        <script dangerouslySetInnerHTML={% raw %}{{ __html: themeScript }}{% endraw %} />
{%- endif %}
      </head>
      <body {{ cls }}="antialiased min-h-dvh flex flex-col bg-background text-foreground">
{% include "header.html.jinja2" %}
        <main {{ cls }}="flex flex-1 flex-col">{% if client_framework == "solid" %}{props.children}{% else %}{children}{% endif %}</main>
{% include "footer.html.jinja2" %}
      </body>
    </html>
  );
}
{% endif -%}
