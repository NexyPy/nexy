{% if useCSR and client_framework == "react" %}{% raw %}import type { ReactNode } from "react";

const themeScript = `
  document.documentElement.classList.toggle(
    "dark",
    localStorage.getItem("nexy-theme") === "dark" ||
      (!("nexy-theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches),
  );
`;

export default function RootLayout({ children }: { children: ReactNode }) {
  return (
    <html lang="en" className="dark" suppressHydrationWarning>
      <head>
        <meta charSet="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="Built with Nexy" />
        <title>Nexy App</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossOrigin="" />
        <link
          href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@400..600&family=Inter:wght@100..900&display=swap"
          rel="stylesheet"
        />
        <script dangerouslySetInnerHTML={{ __html: themeScript }} />
      </head>
      <body className="antialiased min-h-dvh flex flex-col bg-background text-foreground">
        <header className="sticky top-0 z-30 bg-background/80 backdrop-blur border-b border-dashed border-border">
          <nav className="w-container flex items-center justify-between gap-6 px-6 md:px-10 py-4">
            <a href="/" className="flex items-center gap-2 font-semibold tracking-tight">
              <span className="size-2.5 rounded-full bg-accent" />
              Nexy
            </a>
            <a
              href="https://github.com/NexyPy/nexy"
              target="_blank"
              rel="noopener noreferrer"
              className="eyebrow hover:text-foreground ease"
            >
              GitHub &#8599;
            </a>
          </nav>
        </header>
        <main className="flex-1 flex flex-col">{children}</main>
        <footer className="border-t border-dashed border-border">
          <div className="w-container px-6 md:px-10 py-6 flex items-center justify-between gap-4">
            <p className="eyebrow">Built with Nexy</p>
            <p className="eyebrow">MIT</p>
          </div>
        </footer>
      </body>
    </html>
  );
}
