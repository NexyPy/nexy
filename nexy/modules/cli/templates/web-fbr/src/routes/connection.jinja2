{% if solid %}import { For, createSignal, onMount } from "solid-js";
{% elif client_framework == "preact" %}import { useEffect, useState } from "preact/hooks";
{% else %}import { useEffect, useState } from "react";
{% endif %}import { join_team, team } from "@nexy/actions";

{{ calls }}

export default function Connection() {
{% if solid %}  const [members, setMembers] = createSignal<Member[]>([]);
  const [status, setStatus] = createSignal(LOADING);
  const [pending, setPending] = createSignal(false);
{% else %}  const [members, setMembers] = useState<Member[]>([]);
  const [status, setStatus] = useState(LOADING);
  const [pending, setPending] = useState(false);
{% endif %}
  function show(shown: Shown) {
    if (shown.members) setMembers(shown.members);
    setStatus(shown.status);
  }

  async function add(event: { preventDefault(): void; currentTarget: HTMLFormElement }) {
    event.preventDefault();
    setPending(true);
    show(await sendForm(event.currentTarget));
    setPending(false);
  }

{% if solid %}  onMount(async () => show(await loadTeam()));
{% else %}  useEffect(() => {
    loadTeam().then(show);
  }, []);
{% endif %}
  return (
    <>
{% include "connection.html.jinja2" %}
    </>
  );
}
{%- endif %}
