{%- set item_key = "" -%}
{%- else -%}
{%- set each_open = "{members.map((member) => (" -%}{%- set each_close = "))}" -%}
{%- set item_key = " key={member.email}" -%}
{%- endif -%}
{%- set name = "{member.name}" -%}{%- set email = "{member.email}" -%}
