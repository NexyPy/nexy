{% if useCSR %}
{%- set cls = "className" if client_framework == "react" else "class" -%}
{%- set source = "two server actions, <code>team</code> and <code>join_team</code> of <code>src/actions/team.py</code>" -%}
{%- set calls -%}
{% raw %}type Member = { name: string; email: string };
// What the page shows after a call: the team the server answered with (null keeps the list) and a line.
type Shown = { members: Member[] | null; status: string };

const LOADING = "Asking the server for the team...";

function since(started: number): number {
  return Math.round(performance.now() - started);
}

function failed(error: unknown): Shown {
  const reason = error instanceof Error ? error.message : String(error);
  return { members: null, status: `No answer from the server: ${reason}` };
}

// One call to the `team` action, timed.
async function loadTeam(): Promise<Shown> {
  const started = performance.now();
  try {
    const answer = await team();
    return { members: answer.members, status: `Loaded from Python in ${since(started)} ms.` };
  } catch (error) {
    return failed(error);
  }
}

// Sends the form to the `join_team` action; the server answers with the whole team.
async function sendForm(form: HTMLFormElement): Promise<Shown> {
  const fields = new FormData(form);
  const started = performance.now();
  try {
    const answer = await join_team({
      name: String(fields.get("name") ?? ""),
      email: String(fields.get("email") ?? ""),
    });
    if (!answer.note) form.reset();
    return { members: answer.members, status: answer.note || `Saved by Python in ${since(started)} ms.` };
  } catch (error) {
    return failed(error);
  }
}{% endraw %}
{%- endset -%}
{%- if client_framework == "vue" -%}
{%- set each_open = "" -%}{%- set each_close = "" -%}
{%- set item_key = ' v-for="member in members" :key="member.email"' -%}
{%- set name = "{{ member.name }}" -%}{%- set email = "{{ member.email }}" -%}
{%- set submit = '@submit.prevent="add"' -%}{%- set pending = ':disabled="pending"' -%}{%- set status = "{{ status }}" -%}
<script setup lang="ts">
import { onMounted, ref } from "vue";
import { join_team, team } from "@nexy/actions";

{{ calls }}

const members = ref<Member[]>([]);
const status = ref(LOADING);
const pending = ref(false);

function show(shown: Shown) {
  if (shown.members) members.value = shown.members;
  status.value = shown.status;
}

async function add(event: Event) {
  pending.value = true;
  show(await sendForm(event.currentTarget as HTMLFormElement));
  pending.value = false;
}

onMounted(async () => show(await loadTeam()));
</script>

<template>
{% include "connection.html.jinja2" %}
</template>
{%- elif client_framework == "svelte" -%}
{%- set each_open = "{#each members as member (member.email)}" -%}{%- set each_close = "{/each}" -%}
{%- set item_key = "" -%}
{%- set name = "{member.name}" -%}{%- set email = "{member.email}" -%}
{%- set submit = 'onsubmit={add}' -%}{%- set pending = 'disabled={pending}' -%}{%- set status = "{status}" -%}
<script lang="ts">
  import { onMount } from "svelte";
  import { join_team, team } from "@nexy/actions";

{{ calls | indent(2, true) }}

  let members = $state<Member[]>([]);
  let status = $state(LOADING);
  let pending = $state(false);

  function show(shown: Shown) {
    if (shown.members) members = shown.members;
    status = shown.status;
  }

  async function add(event: SubmitEvent & { currentTarget: HTMLFormElement }) {
    event.preventDefault();
    pending = true;
    show(await sendForm(event.currentTarget));
    pending = false;
  }

  onMount(async () => show(await loadTeam()));
</script>

{% include "connection.html.jinja2" %}
{%- else -%}
