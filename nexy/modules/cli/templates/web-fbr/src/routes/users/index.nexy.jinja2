{% if not useCSR %}{% if orm != "None" %}
{% if orm == "Tortoise-ORM" %}
---
import asyncio
from src.services.user_service import UserService
users = asyncio.run(UserService.get_all())
---
{% else %}
---
from src.services.user_service import UserService
users = UserService.get_all()
---
{% endif %}{% raw %}
<section class="nx-container nx-article">
    <h1 class="nx-title">Users</h1>
    <div class="nx-list">
        {% for user in users %}
        <div class="nx-row">
            <span>{{ user.name }}</span>
            <span>{{ user.email }}</span>
        </div>
        {% endfor %}
    </div>
</section>{% endraw %}
{% endif %}{% endif %}