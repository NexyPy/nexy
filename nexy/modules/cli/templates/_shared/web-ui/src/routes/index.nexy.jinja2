{% if not useCSR %}{% raw %}---
from "@/components/Button.nexy" import Button
from "@/components/Container.nexy" import Container
from "@/components/Frame.nexy" import Frame
from "@/components/FrameworkLogo.nexy" import FrameworkLogo
from "@/components/LinePattern.nexy" import LinePattern
from "@/components/LivePanel.nexy" import LivePanel
from "@/components/SectionHead.nexy" import SectionHead
from "@/components/Steps.nexy" import Steps

arrow_down = "M12 5v14M5 12l7 7 7-7"
glow = "bg-[image:radial-gradient(60%_60%_at_85%_15%,rgb(63_224_200/0.14),transparent_70%)]"
---
<section class="relative flex min-h-dvh items-end overflow-hidden bg-ink pb-16 pt-34 text-paper">
  <LinePattern side="right" />
  <div class="absolute inset-0 {{ glow }}" aria-hidden="true"></div>
  <Container class_name="relative grid items-end gap-12 md:grid-cols-[1.3fr_1fr]">
    <div class="flex flex-col gap-6">
      <h1 class="max-w-[12ch] text-6xl leading-[1.02] md:text-8xl">Your app is running.</h1>
      <p class="max-w-[42ch] text-lg text-paper/65">
        Change a word on this page and save. It updates before you look back.
      </p>
      <div class="mt-2 flex flex-wrap gap-4">
        <Button href="#first-steps" tone="on-ink" icon="{{ arrow_down }}">Make your first change</Button>
        <Button href="https://github.com/NexyPy/nexy#readme" tone="on-ink" variant="outline">Read the docs</Button>
      </div>
    </div>
    <LivePanel />
  </Container>
</section>

<section id="first-steps" class="scroll-mt-4 py-24">
  <Container class_name="grid gap-12 md:grid-cols-[1fr_1.4fr]">
    <div class="self-start md:sticky md:top-28">
      <SectionHead
        label="Your first minutes"
        title="Make it yours in three steps."
        description="Each one takes a minute or less."
      />
      <Frame class_name="grid aspect-[4/3] place-items-center border border-border bg-ink text-paper dark:bg-background-second">
        <FrameworkLogo class_name="size-32 text-accent" />
      </Frame>
    </div>
    <Steps />
  </Container>
</section>
{% endraw %}{% endif %}
