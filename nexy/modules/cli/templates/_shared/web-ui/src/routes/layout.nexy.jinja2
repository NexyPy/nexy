{% if not useCSR %}{% raw %}---
from "@/components/Header.nexy" import Header
from "@/components/Footer.nexy" import Footer
from nexy import Vite

children: prop[NexyElement]
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Pages, an API and interactive parts in one project.">
    <title>Nexy App</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500..700&family=Geist:wght@400..600&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">
    <!-- Applied before the first paint, so a dark page never flashes white. -->
    <style>html{background:#ffffff;color-scheme:light}html.dark{background:#0a0a0a;color-scheme:dark}</style>
    <script>
        try {
            var saved = localStorage.getItem("nexy-theme");
            var dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.classList.toggle("dark", dark);
        } catch (error) {}
    </script>
    <Vite />
</head>
<body class="flex min-h-dvh flex-col">
    <Header />
    <main class="flex flex-1 flex-col">{{ children }}</main>
    <Footer />
</body>
</html>
{% endraw %}{% endif %}
