{% if not useCSR %}{% raw %}---
path: prop[str]
size: prop[int] = 20
---
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{ path }}" /></svg>
{% endraw %}{% endif %}
