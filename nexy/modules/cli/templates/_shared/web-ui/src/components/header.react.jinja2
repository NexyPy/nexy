{% if useCSR %}{% raw %}import { useCallback, useRef, useState } from "react";
import { Link } from "@nexy/client";

import Button from "@/components/button.tsx";
import Icon from "@/components/icon.tsx";
import LinePattern from "@/components/line-pattern.tsx";
import Sheet from "@/components/sheet.tsx";
import ThemeToggle from "@/components/theme-toggle.tsx";

const LINK =
  "px-3.5 py-2 font-mono text-xs uppercase tracking-[0.04em] transition-opacity hover:opacity-60 aria-[current=page]:underline aria-[current=page]:underline-offset-4";
const MENU = "M4 7h16M4 12h16M4 17h16";
const EXTERNAL = "M7 17L17 7M8 7h9v9";
const SHEET_LINK =
  "flex min-h-11 items-center gap-2 px-3 text-base transition-colors hover:bg-paper/5 aria-[current=page]:bg-paper/10 aria-[current=page]:font-medium";
const BOOK = "M2 4h6a4 4 0 014 4v12a3 3 0 00-3-3H2zM22 4h-6a4 4 0 00-4 4v12a3 3 0 013-3h7z";

export default function Header() {
  const [open, setOpen] = useState(false);
  const opener = useRef<HTMLButtonElement>(null);
  // Closing gives the focus back to the button that opened the menu.
  const close = useCallback(() => {
    setOpen(false);
    opener.current?.focus();
  }, []);

  return (
    <>
      <header className="fixed inset-x-0 top-0 z-20 py-4 [view-transition-name:nx-header]">
        <nav
          className="relative mx-auto flex w-[72rem] max-w-[calc(100%-2rem)] items-center justify-between border border-paper/10 bg-ink/85 px-5 py-3 text-paper shadow-[0_10px_30px_-12px_rgb(0_0_0/0.4)] backdrop-blur-[4px]"
          aria-label="Main"
        >
          <LinePattern side="right" />
          <a href="/" aria-label="Nexy, home" onClick={() => setOpen(false)} className="relative">
            <img src="/nexy.svg" alt="Nexy" className="h-5 invert" />
          </a>

          <div className="relative flex items-center gap-2">
            <div className="hidden items-center sm:flex">
              <Link href="/" className={LINK}>Home</Link>
              <Link href="/about" className={LINK}>About</Link>
              <Link href="/todos" className={LINK}>Todos</Link>
            </div>
            <ThemeToggle />
            <span className="hidden sm:block">
              <Button href="https://github.com/NexyPy/nexy#readme" tone="on-ink" size="sm" icon={BOOK}>
                Docs
              </Button>
            </span>
            <button
              ref={opener}
              type="button"
              aria-label="Open menu"
              aria-expanded={open}
              aria-controls="mobile-menu"
              onClick={() => setOpen(true)}
              className="-my-1.5 -mr-2 ml-1 grid size-11 place-items-center sm:hidden"
            >
              <Icon path={MENU} />
            </button>
          </div>
        </nav>
      </header>

      <Sheet id="mobile-menu" open={open} onClose={close} title="Menu">
        <Link href="/" className={SHEET_LINK} onClick={close}>Home</Link>
        <Link href="/about" className={SHEET_LINK} onClick={close}>About</Link>
        <Link href="/todos" className={SHEET_LINK} onClick={close}>Todos</Link>
        <a href="https://github.com/NexyPy/nexy#readme" target="_blank" rel="noopener noreferrer" className={`${SHEET_LINK} justify-between`} onClick={close}>
          Docs
          <Icon path={EXTERNAL} size={16} />
        </a>
      </Sheet>
    </>
  );
}
{% endraw %}{% endif %}
