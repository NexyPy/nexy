{% if not useCSR %}{% raw %}---
from "@/components/Button.nexy" import Button
from "@/components/Icon.nexy" import Icon
from "@/components/LinePattern.nexy" import LinePattern
from "@/components/ThemeToggle.nexy" import ThemeToggle
from nexy import usePathname

pathname = usePathname()

link = "px-3.5 py-2 font-mono text-xs uppercase tracking-[0.04em] transition-opacity hover:opacity-60 aria-[current=page]:underline aria-[current=page]:underline-offset-4"
menu = "M4 7h16M4 12h16M4 17h16"
close = "M18 6L6 18M6 6l12 12"
book = "M2 4h6a4 4 0 014 4v12a3 3 0 00-3-3H2zM22 4h-6a4 4 0 00-4 4v12a3 3 0 013-3h7z"
pages = [("/", "Home"), ("/about", "About")]
---
<header class="fixed inset-x-0 top-0 z-20 py-4 [view-transition-name:nx-header]">
  <nav
    class="relative mx-auto flex w-[72rem] max-w-[calc(100%-2rem)] items-center justify-between border border-paper/10 bg-ink/85 px-5 py-3 text-paper shadow-[0_10px_30px_-12px_rgb(0_0_0/0.4)] backdrop-blur-[4px]"
    aria-label="Main"
  >
    <LinePattern side="right" />
    <a href="/" aria-label="Nexy, home" class="relative">
      <img src="/nexy.svg" alt="Nexy" class="h-5 invert" />
    </a>

    <div class="relative flex items-center gap-2">
      <div class="hidden items-center sm:flex">
        {% for href, label in pages %}
        <a href="{{ href }}" class="{{ link }}"{% if pathname == href %} aria-current="page"{% endif %}>{{ label }}</a>
        {% endfor %}
      </div>
      <ThemeToggle />
      <span class="hidden sm:block">
        <Button href="https://github.com/NexyPy/nexy#readme" tone="on-ink" size="sm" icon="{{ book }}">Docs</Button>
      </span>
      <button
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-sheet-button
        class="ml-1 grid size-8 place-items-center sm:hidden"
      >
        <span data-sheet-open><Icon path="{{ menu }}" /></span>
        <span class="hidden" data-sheet-close-icon><Icon path="{{ close }}" /></span>
      </button>
    </div>
  </nav>
</header>

<div class="hidden" data-sheet>
  <div class="sheet-scrim fixed inset-0 z-40 bg-ink/60" data-sheet-scrim aria-hidden="true"></div>
  <div
    id="mobile-menu"
    class="sheet fixed inset-y-0 left-0 z-50 flex w-72 max-w-[85%] flex-col border-r border-paper/10 bg-ink p-5 text-paper shadow-[0_10px_30px_-12px_rgb(0_0_0/0.6)] sm:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
    tabindex="-1"
    data-side="left"
  >
    <button
      type="button"
      aria-label="Close menu"
      data-sheet-dismiss
      class="mb-4 ml-auto grid size-8 place-items-center"
    >
      <Icon path="{{ close }}" />
    </button>
    <nav class="flex flex-col" aria-label="Menu">
      {% for href, label in pages %}
      <a href="{{ href }}" class="{{ link }}"{% if pathname == href %} aria-current="page"{% endif %}>{{ label }}</a>
      {% endfor %}
      <a href="https://github.com/NexyPy/nexy#readme" target="_blank" rel="noopener noreferrer" class="{{ link }}">Docs</a>
    </nav>
  </div>
</div>
<script>
  (function () {
    var button = document.querySelector("[data-sheet-button]");
    var sheet = document.querySelector("[data-sheet]");
    if (!button || !sheet) return;
    var opener = null;

    function isOpen() {
      return button.getAttribute("aria-expanded") === "true";
    }

    function setOpen(open) {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      sheet.classList.toggle("hidden", !open);
      document.body.style.overflow = open ? "hidden" : "";
      button.querySelector("[data-sheet-open]").classList.toggle("hidden", open);
      button.querySelector("[data-sheet-close-icon]").classList.toggle("hidden", !open);
      var panel = sheet.querySelector("[role='dialog']");
      if (open) {
        opener = document.activeElement;
        panel.focus();
      } else if (opener) {
        opener.focus();
        opener = null;
      }
    }

    button.addEventListener("click", function () {
      setOpen(!isOpen());
    });

    // The scrim and the close button both dismiss: one listener on the sheet reads the target.
    sheet.addEventListener("click", function (event) {
      if (event.target.closest("[data-sheet-dismiss],[data-sheet-scrim]")) setOpen(false);
    });

    // The panel holds the focus while it is open, so Escape arrives here without a global listener.
    sheet.addEventListener("keydown", function (event) {
      if (event.key === "Escape") setOpen(false);
    });
  })();
</script>
{% endraw %}{% endif %}
