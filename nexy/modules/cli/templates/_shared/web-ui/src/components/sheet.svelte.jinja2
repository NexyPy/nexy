{% if useCSR %}{% raw %}<script lang="ts">
  import type { Snippet } from "svelte";

  import Icon from "@/components/icon.svelte";

  let {
    open,
    onclose,
    label,
    children,
  }: { open: boolean; onclose: () => void; label: string; children?: Snippet } = $props();

  const CLOSE = "M18 6L6 18M6 6l12 12";

  let panel = $state<HTMLElement | null>(null);

  function onKey(event: KeyboardEvent) {
    if (event.key === "Escape") onclose();
  }

  // While it is open the page behind it holds still, and the keyboard belongs to the panel.
  $effect(() => {
    if (!open) return;
    panel.focus();
    const previous = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    return () => {
      document.body.style.overflow = previous;
    };
  });
</script>

{#if open}
  <div class="fixed inset-0 z-40 sm:hidden">
    <div class="sheet-scrim absolute inset-0 bg-ink/60" aria-hidden="true" onclick={onclose}></div>
    <div
      bind:this={panel}
      tabindex="-1"
      class="sheet absolute inset-y-0 left-0 flex w-72 max-w-[85%] flex-col overflow-y-auto border-r border-paper/10 bg-ink p-5 text-paper shadow-[0_10px_30px_-12px_rgb(0_0_0/0.6)] outline-none"
      role="dialog"
      aria-modal="true"
      aria-label={label}
      data-side="left"
      onkeydown={onKey}
    >
      <button
        type="button"
        class="mb-4 ml-auto grid size-8 place-items-center"
        aria-label="Close menu"
        onclick={onclose}
      >
        <Icon path={CLOSE} />
      </button>
      <nav class="flex flex-col" aria-label={label}>
        {@render children?.()}
      </nav>
    </div>
  </div>
{/if}
{% endraw %}{% endif %}
