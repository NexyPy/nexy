{% if not useCSR %}{% raw %}---
from "@/components/Icon.nexy" import Icon

sun = "M12 3v2M12 19v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M3 12h2M19 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4M12 8a4 4 0 100 8 4 4 0 000-8z"
moon = "M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"
---
<button
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Dark mode"
  data-theme-toggle
  class="relative h-7 w-12 shrink-0 cursor-pointer rounded-full border border-paper/30 transition-colors hover:border-paper"
>
  <span class="absolute left-0.5 top-0.5 grid size-5.5 place-items-center rounded-full bg-paper text-ink transition-transform duration-300 dark:translate-x-5">
    <span class="grid dark:hidden"><Icon path="{{ sun }}" size="14" /></span>
    <span class="hidden dark:grid"><Icon path="{{ moon }}" size="14" /></span>
  </span>
</button>
<script>
  // The saved theme is applied in the head before the first paint. Here the switch flips it,
  // remembers the choice and keeps aria-checked in step.
  (function () {
    var button = document.querySelector("[data-theme-toggle]");
    var root = document.documentElement;
    if (!button) return;
    function sync() {
      button.setAttribute("aria-checked", String(root.classList.contains("dark")));
    }
    button.addEventListener("click", function () {
      var dark = root.classList.toggle("dark");
      try {
        localStorage.setItem("nexy-theme", dark ? "dark" : "light");
      } catch (error) {
        // The choice only lasts for this visit when storage is blocked.
      }
      sync();
    });
    sync();
  })();
</script>
{% endraw %}{% endif %}
