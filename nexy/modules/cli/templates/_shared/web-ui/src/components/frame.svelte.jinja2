{% if useCSR %}{% raw %}<script lang="ts">
  import type { Snippet } from "svelte";

  const MARK = "pointer-events-none absolute size-3 border-current opacity-60 transition-all duration-200";
  const MARKS = [
    "-left-px -top-px border-l-2 border-t-2 group-hover:left-1 group-hover:top-1",
    "-right-px -top-px border-r-2 border-t-2 group-hover:right-1 group-hover:top-1",
    "-bottom-px -left-px border-b-2 border-l-2 group-hover:bottom-1 group-hover:left-1",
    "-bottom-px -right-px border-b-2 border-r-2 group-hover:bottom-1 group-hover:right-1",
  ];

  // A box with four corner marks that move inward on hover.
  let { children, class: className = "" }: { children: Snippet; class?: string } = $props();
</script>

<div class="group relative {className}">
  {#each MARKS as position (position)}
    <span class="{MARK} {position}" aria-hidden="true"></span>
  {/each}
  {@render children()}
</div>
{% endraw %}{% endif %}
