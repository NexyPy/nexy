{% if useCSR %}{% raw %}import { useEffect, useId, useLayoutEffect, useRef, useState } from "preact/hooks";
import type { ComponentChildren } from "preact";

import Icon from "@/components/icon.tsx";

const CLOSE = "M18 6L6 18M6 6l12 12";

type SheetProps = {
  id: string;
  open: boolean;
  onClose: () => void;
  /** The visible title, which also names the dialog for a screen reader. */
  title: string;
  children: ComponentChildren;
};

// Tab and Shift+Tab wrap inside the panel instead of walking out into the page: the close button
// comes first, the last link of the menu last.
function trap(
  event: KeyboardEvent,
  panel: HTMLElement | null,
  first: HTMLElement | null,
  last: Element | null,
) {
  const here = document.activeElement;
  const away = event.shiftKey ? here === first || here === panel : here === last;
  if (!away || !(last instanceof HTMLElement) || !first) return;
  event.preventDefault();
  (event.shiftKey ? last : first).focus();
}

// A modal panel that slides in from the left edge, over a scrim. While it is open it holds the
// keyboard (Tab wraps, Escape closes), the page behind holds still, and a wide screen closes it.
// Closing plays the slide back before the panel leaves the page.
export default function Sheet({ id, open, onClose, title, children }: SheetProps) {
  const panel = useRef<HTMLDivElement>(null);
  const closer = useRef<HTMLButtonElement>(null);
  const links = useRef<HTMLElement>(null);
  const titleId = useId();
  const [shown, setShown] = useState(open);

  useEffect(() => {
    if (open) setShown(true);
  }, [open]);

  // A layout effect, run right after the render: Preact defers a plain effect past the paint, and a
  // key pressed in between would reach the button instead of the panel.
  useLayoutEffect(() => {
    const element = panel.current;
    if (!open || !element) return;
    element.focus();
    document.body.style.overflow = "hidden";
    const wide = window.matchMedia("(min-width: 40rem)");
    wide.onchange = () => wide.matches && onClose();
    return () => {
      document.body.style.overflow = "";
      wide.onchange = null;
    };
  }, [open, shown, onClose]);

  useEffect(() => {
    const element = panel.current;
    if (open || !element) return;
    const moves = element.getAnimations().map((move) => move.finished);
    Promise.all(moves).then(() => setShown(false));
  }, [open]);

  // The focus never leaves the open panel, so its own key handler sees every key.
  const onKey = (event: KeyboardEvent) => {
    if (event.key === "Escape") onClose();
    const last = links.current?.lastElementChild ?? null;
    if (event.key === "Tab") trap(event, panel.current, closer.current, last);
  };

  if (!shown) return null;
  const state = open ? "open" : "closed";

  return (
    <div class="fixed inset-0 z-50 sm:hidden">
      <div class="sheet-scrim absolute inset-0 bg-ink/70" data-state={state} onClick={onClose} aria-hidden="true" />
      <div
        ref={panel}
        id={id}
        tabIndex={-1}
        class="sheet absolute inset-y-0 left-0 flex w-3/4 max-w-sm flex-col border-r border-paper/10 bg-ink text-paper shadow-[0_10px_30px_-12px_rgb(0_0_0/0.6)] outline-none"
        role="dialog"
        aria-modal="true"
        aria-labelledby={titleId}
        data-side="left"
        data-state={state}
        onKeyDown={onKey}
      >
        <div class="flex items-center gap-3 border-b border-paper/10 py-4 pl-5 pr-16">
          <img src="/nexy.svg" alt="" class="h-5 invert" />
          <h2 id={titleId} class="font-mono text-xs uppercase tracking-[0.04em] text-paper/60">
            {title}
          </h2>
        </div>
        <button
          ref={closer}
          type="button"
          onClick={onClose}
          aria-label="Close menu"
          class="absolute right-2 top-1.5 grid size-11 place-items-center opacity-70 transition-opacity hover:opacity-100 focus-visible:opacity-100"
        >
          <Icon path={CLOSE} />
        </button>
        <nav ref={links} class="flex flex-1 flex-col overflow-y-auto p-3" aria-label="Pages">
          {children}
        </nav>
      </div>
    </div>
  );
}
{% endraw %}{% endif %}
