{% if style == "tailwind" -%}
@import "tailwindcss";

@custom-variant dark (&:is(.dark *));
{%- elif style == "unocss" -%}
@layer base, components, utilities;
{%- endif %}

{% set accent = "#61DAFB" %}
{% if client_framework == "vue" %}
{% set accent = "#42B883" %}
{% elif client_framework == "svelte" %}
{% set accent = "#FF3E00" %}
{% elif client_framework == "solid" %}
{% set accent = "#4F88C6" %}
{% elif client_framework == "preact" %}
{% set accent = "#8E6CF0" %}
{% elif client_framework == "none" %}
{% set accent = "#00D084" %}
{% endif %}

:root {
  color-scheme: light;
  font-family: "Geist", "Inter", system-ui, sans-serif;
  --accent: {{ accent }};
  /* Nexy's own colours: mint mist in the light, deep emerald in the dark. */
  --background: light-dark(#f2f7f4, #062b24);
  --background-second: light-dark(#ffffff, #0a3a30);
  --foreground: light-dark(#0a2531, #eaf6f1);
  --foreground-second: light-dark(#4a6068, #9cc4b8);
  --border: light-dark(#d8e5df, #14503f);
  --border-second: light-dark(#c0d4cb, #1e6b55);
  --brand: light-dark(#0b8f6b, #2ee6a6);
}

.dark {
  color-scheme: dark;
}

{% if style == "tailwind" %}
@theme {
  --color-background: var(--background);
  --color-background-second: var(--background-second);
  --color-foreground: var(--foreground);
  --color-foreground-second: var(--foreground-second);
  --color-border: var(--border);
  --color-border-second: var(--border-second);
  --color-accent: var(--accent);
  --color-brand: var(--brand);

  --font-mono: "Geist Mono", ui-monospace, monospace;
}
{% endif %}

{% if style in ("vanilla", "other") %}
{% include "vanilla.css" %}
{% else %}
@layer base {
  body {
    background-color: var(--background);
    color: var(--foreground);
  }
  ::selection {
    background-color: color-mix(in oklab, var(--brand) 30%, transparent);
  }
}
{% endif %}

{% if starter | default(true) %}{% include "starter.css" %}{% endif %}
