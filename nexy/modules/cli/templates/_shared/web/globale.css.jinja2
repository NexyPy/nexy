{% if style == "tailwind" -%}
@import "tailwindcss";

@custom-variant dark (&:is(.dark *));
{%- elif style == "unocss" -%}
@layer base, components, utilities;
{%- endif %}

{% set accent = "#61DAFB" %}
{% if client_framework == "vue" %}
{% set accent = "#42B883" %}
{% elif client_framework == "svelte" %}
{% set accent = "#FF3E00" %}
{% elif client_framework == "solid" %}
{% set accent = "#4F88C6" %}
{% elif client_framework == "preact" %}
{% set accent = "#8E6CF0" %}
{% elif client_framework == "none" %}
{% set accent = "#00D084" %}
{% endif %}

:root {
  color-scheme: light;
  font-family: "Geist", "Inter", system-ui, sans-serif;
  --accent: {{ accent }};
  --background: light-dark(#ffffff, #0a0a0a);
  --background-second: light-dark(#fafafa, #141414);
  --foreground: light-dark(#171717, #ededed);
  --foreground-second: light-dark(#666666, #a1a1a1);
  --border: light-dark(#e5e5e5, #262626);
  --border-second: light-dark(#d4d4d4, #404040);
}

.dark {
  color-scheme: dark;
}

{% if style == "tailwind" %}
@theme {
  --color-background: var(--background);
  --color-background-second: var(--background-second);
  --color-foreground: var(--foreground);
  --color-foreground-second: var(--foreground-second);
  --color-border: var(--border);
  --color-border-second: var(--border-second);
  --color-accent: var(--accent);

  --font-mono: "Geist Mono", ui-monospace, monospace;
}
{% endif %}

{% if style in ("vanilla", "other") %}
{% include "vanilla.css" %}
{% else %}
@layer base {
  body {
    background-color: var(--background);
    color: var(--foreground);
  }
  h1, h2, h3 {
    font-family: "Geist", "Inter", sans-serif;
  }
  code {
    @apply rounded border border-border bg-background-second px-1.5 py-0.5 font-mono text-[0.85em];
  }
  ::selection {
    background-color: color-mix(in oklab, var(--foreground) 20%, transparent);
  }
}

@layer components {
  /* The shared part of both buttons; Tailwind 4 cannot @apply another component class. */
  .btn-primary,
  .btn-ghost {
    @apply inline-flex h-10 cursor-pointer items-center justify-center gap-2 rounded-md px-4 text-sm font-medium no-underline transition-colors;
  }
  .btn-primary {
    @apply bg-foreground text-background hover:opacity-85;
  }
  .btn-ghost {
    @apply border border-border text-foreground hover:bg-background-second;
  }

  .nav-link {
    @apply text-sm text-foreground-second no-underline transition-colors hover:text-foreground;
  }
  .nav-link[aria-current="page"] {
    color: var(--foreground);
  }

  .theme-toggle {
    @apply inline-flex size-8 cursor-pointer items-center justify-center rounded-md text-foreground-second transition-colors hover:bg-background-second hover:text-foreground;
  }
}
{% endif %}
