{% if style == "tailwind" -%}
@import "tailwindcss";

@custom-variant dark (&:is(.dark *));
{%- elif style == "unocss" -%}
@layer base, components, utilities;
{%- endif %}

{% set accent = "#61DAFB" %}
{% if client_framework == "vue" %}
{% set accent = "#42B883" %}
{% elif client_framework == "svelte" %}
{% set accent = "#FF3E00" %}
{% elif client_framework == "solid" %}
{% set accent = "#4F88C6" %}
{% elif client_framework == "preact" %}
{% set accent = "#8E6CF0" %}
{% elif client_framework == "none" %}
{% set accent = "#00D084" %}
{% endif %}

:root {
  color-scheme: light;
  font-family: "Geist", "Inter", system-ui, sans-serif;
  --accent: {{ accent }};
  --background: light-dark(#f6f7f9, #0b1016);
  --background-second: light-dark(#ffffff, #111821);
  --foreground: light-dark(#0f1720, #e8ecf2);
  --foreground-second: light-dark(#5a6678, #93a0b3);
  --border: light-dark(#e1e5eb, #1e2835);
  --border-second: light-dark(#cbd2dc, #2e3b4c);
}

.dark {
  color-scheme: dark;
}

{% if style == "tailwind" %}
@theme {
  --color-background: var(--background);
  --color-background-second: var(--background-second);
  --color-foreground: var(--foreground);
  --color-foreground-second: var(--foreground-second);
  --color-border: var(--border);
  --color-border-second: var(--border-second);
  --color-accent: var(--accent);

  --font-mono: "Geist Mono", ui-monospace, monospace;
}
{% endif %}

{% if style in ("vanilla", "other") %}
{% include "vanilla.css" %}
{% else %}
@layer base {
  body {
    background-color: var(--background);
    color: var(--foreground);
  }
  ::selection {
    background-color: color-mix(in oklab, var(--accent) 28%, transparent);
  }
}
{% endif %}

{% if starter | default(true) %}{% include "starter.css" %}{% endif %}
