[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "A Nexy web application with {{ client_framework or 'vanilla' }} components"
dependencies = [
    "nexy>={{ nexy_version }}",
{%- for package in python_packages | default([]) %}
    "{{ package }}",
{%- endfor %}
]
requires-python = ">=3.12"
