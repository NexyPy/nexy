import { defineConfig, presetWind4, transformerDirectives } from 'unocss'

// The design tokens live in src/globale.css as CSS variables; the utilities read them.
export default defineConfig({
  presets: [presetWind4({ dark: 'class' })],
  transformers: [transformerDirectives()],
{%- if not useCSR %}
  // Server pages are .nexy files: tell UnoCSS to read them for utility classes.
  content: {
    filesystem: ['src/**/*.nexy'],
    pipeline: { include: [/\.(vue|svelte|[jt]sx|mdx?|astro|html|nexy)($|\?)/] },
  },
{%- endif %}
  // Same layers as Tailwind: the reset is `base`, utilities win over `components`.
  outputToCssLayers: {
    cssLayerName: (layer) => (layer === 'shortcuts' ? 'components' : layer === 'default' ? 'utilities' : 'base'),
  },
  theme: {
    colors: {
      background: 'var(--background)',
      'background-second': 'var(--background-second)',
      foreground: 'var(--foreground)',
      'foreground-second': 'var(--foreground-second)',
      border: 'var(--border)',
      'border-second': 'var(--border-second)',
      accent: 'var(--accent)',
{%- if utility_ui %}
      ink: 'var(--ink)',
      paper: 'var(--paper)',
      signal: 'var(--signal)',
{%- endif %}
    },
    font: {
{%- if utility_ui %}
      display: '"Fraunces", ui-serif, Georgia, serif',
{%- endif %}
      mono: '"Geist Mono", ui-monospace, monospace',
    },
  },
})
