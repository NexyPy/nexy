---
items = [
    {"label": "Docs", "href": "https://github.com/NexyPy/nexy"},
    {"label": "Showcase", "href": "https://github.com/NexyPy/nexy"},
    {"label": "Community", "href": "https://github.com/NexyPy/nexy"},
]
---
<header class="sticky top-0 z-30 bg-background/80 backdrop-blur border-b border-dashed border-border">
    <nav class="w-container flex items-center justify-between gap-6 px-6 md:px-10 py-4" aria-label="Main">
        <div class="flex items-center gap-8">
            <a href="/" aria-label="Nexy home" class="dark:hue-rotate-140 dark:invert">
                <img src="/public/nexy.svg" alt="Nexy" class="w-20">
            </a>
            <ul class="hidden md:flex items-center gap-6">
                {% for item in items %}
                <li>
                    <a href="{{item.get('href')}}" target="_blank" rel="noopener noreferrer"
                        class="eyebrow hover:text-foreground ease">{{item.get('label')}}</a>
                </li>
                {% endfor %}
            </ul>
        </div>
        <a href="https://github.com/NexyPy/nexy" target="_blank" rel="noopener noreferrer"
            class="ease inline-flex items-center gap-2 rounded-full bg-foreground text-background px-4 py-1.5 text-sm font-medium hover:opacity-85">
            Get started
            <span aria-hidden="true">&#8594;</span>
        </a>
    </nav>
</header>
