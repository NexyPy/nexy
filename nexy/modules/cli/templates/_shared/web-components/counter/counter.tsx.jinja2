{% if client_framework in ("react", "solid", "preact") %}
{%- set cls = "className" if client_framework == "react" else "class" -%}
{%- if client_framework == "solid" -%}
import { createSignal } from "solid-js";
{%- elif client_framework == "preact" -%}
import { useState } from "preact/hooks";
{%- else -%}
import { useState } from "react";
{%- endif %}

export default function Counter() {
{%- if client_framework == "solid" %}
  const [count, setCount] = createSignal(0);
{%- else %}
  const [count, setCount] = useState(0);
{%- endif %}

  return (
    <div {{ cls }}="flex flex-col items-center gap-6">
      <output {{ cls }}="text-7xl font-semibold tabular-nums" aria-live="polite">
        {% raw %}{{% endraw %}{% if client_framework == "solid" %}count(){% else %}count{% endif %}{% raw %}}{% endraw %}
      </output>
      <div {{ cls }}="flex gap-3">
        <button type="button" {{ cls }}="btn-ghost w-10 px-0" aria-label="Decrease" onClick={() => setCount((value) => value - 1)}>
          -
        </button>
        <button type="button" {{ cls }}="btn-primary w-10 px-0" aria-label="Increase" onClick={() => setCount((value) => value + 1)}>
          +
        </button>
      </div>
    </div>
  );
}
{% endif %}
