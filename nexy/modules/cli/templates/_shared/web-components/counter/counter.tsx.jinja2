{% if client_framework in ("react", "solid", "preact") %}
{%- set cls = "className" if client_framework == "react" else "class" -%}
{%- if client_framework == "solid" -%}
import { createSignal } from "solid-js";
{%- elif client_framework == "preact" -%}
import { useState } from "preact/hooks";
{%- else -%}
import { useState } from "react";
{%- endif %}

export default function Counter() {
{%- if client_framework == "solid" %}
  const [count, setCount] = createSignal(0);
{%- else %}
  const [count, setCount] = useState(0);
{%- endif %}

  return (
    <div {{ cls }}="nx-counter">
      <button type="button" {{ cls }}="nx-step" aria-label="Decrease" onClick={() => setCount((value) => value - 1)}>
        −
      </button>
      <output {{ cls }}="nx-count" aria-live="polite">
        {% raw %}{{% endraw %}{% if client_framework == "solid" %}count(){% else %}count{% endif %}{% raw %}}{% endraw %}
      </output>
      <button type="button" {{ cls }}="nx-step" aria-label="Increase" onClick={() => setCount((value) => value + 1)}>
        +
      </button>
    </div>
  );
}
{% endif %}
