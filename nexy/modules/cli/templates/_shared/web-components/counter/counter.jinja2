{% if client_framework == "vue" %}
<script setup lang="ts">
import { ref } from 'vue'

const count = ref(0)
</script>

<template>
  <div class="flex flex-col items-center gap-6">
    <output class="text-7xl font-semibold tabular-nums" aria-live="polite">{% raw %}{{ count }}{% endraw %}</output>
    <div class="flex gap-3">
      <button type="button" class="btn-ghost w-10 px-0" aria-label="Decrease" @click="count--">-</button>
      <button type="button" class="btn-primary w-10 px-0" aria-label="Increase" @click="count++">+</button>
    </div>
  </div>
</template>
{% elif client_framework == "svelte" %}
<script lang="ts">
  let count = $state(0);
</script>

<div class="flex flex-col items-center gap-6">
  <output class="text-7xl font-semibold tabular-nums" aria-live="polite">{% raw %}{count}{% endraw %}</output>
  <div class="flex gap-3">
    <button type="button" class="btn-ghost w-10 px-0" aria-label="Decrease" onclick={() => count--}>-</button>
    <button type="button" class="btn-primary w-10 px-0" aria-label="Increase" onclick={() => count++}>+</button>
  </div>
</div>
{% elif client_framework == "none" %}
<div class="flex flex-col items-center gap-6">
  <output id="counter" class="text-7xl font-semibold tabular-nums" aria-live="polite">0</output>
  <div class="flex gap-3">
    <button type="button" id="counter-decrease" class="btn-ghost w-10 px-0" aria-label="Decrease">-</button>
    <button type="button" id="counter-increase" class="btn-primary w-10 px-0" aria-label="Increase">+</button>
  </div>
</div>
<script>
  const output = document.getElementById("counter");
  let count = 0;
  const show = (next) => {
    count = next;
    output.textContent = String(count);
  };
  document.getElementById("counter-decrease").addEventListener("click", () => show(count - 1));
  document.getElementById("counter-increase").addEventListener("click", () => show(count + 1));
</script>
{% endif %}
