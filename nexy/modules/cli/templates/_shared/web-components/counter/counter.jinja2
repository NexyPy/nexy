{% if client_framework == "vue" %}
<script setup lang="ts">
import { ref } from 'vue'

const count = ref(0)
</script>

<template>
  <div class="nx-counter">
    <button type="button" class="nx-step" aria-label="Decrease" @click="count--">−</button>
    <output class="nx-count" aria-live="polite">{% raw %}{{ count }}{% endraw %}</output>
    <button type="button" class="nx-step" aria-label="Increase" @click="count++">+</button>
  </div>
</template>
{% elif client_framework == "svelte" %}
<script lang="ts">
  let count = $state(0);
</script>

<div class="nx-counter">
  <button type="button" class="nx-step" aria-label="Decrease" onclick={() => count--}>−</button>
  <output class="nx-count" aria-live="polite">{% raw %}{count}{% endraw %}</output>
  <button type="button" class="nx-step" aria-label="Increase" onclick={() => count++}>+</button>
</div>
{% elif client_framework == "none" %}
<div class="nx-counter">
  <button type="button" id="counter-decrease" class="nx-step" aria-label="Decrease">−</button>
  <output id="counter" class="nx-count" aria-live="polite">0</output>
  <button type="button" id="counter-increase" class="nx-step" aria-label="Increase">+</button>
</div>
<script>
  const output = document.getElementById("counter");
  let count = 0;
  const show = (next) => {
    count = next;
    output.textContent = String(count);
  };
  document.getElementById("counter-decrease").addEventListener("click", () => show(count - 1));
  document.getElementById("counter-increase").addEventListener("click", () => show(count + 1));
</script>
{% endif %}
