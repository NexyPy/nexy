{% if orm != "None" %}
---
users: list
---

<section class="nx-container nx-article">
    <h1 class="nx-title">Users</h1>
    <div class="nx-list">
        {% for user in users %}
        <div class="nx-row">
            <span>{{ user.name }}</span>
            <span>{{ user.email }}</span>
        </div>
        {% endfor %}
    </div>
</section>
{% endif %}
