<section {{ cls }}="relative isolate overflow-hidden">
  <div {{ cls }}="bg-glow absolute inset-0 -z-10"></div>
  <div {{ cls }}="bg-grid absolute inset-0 -z-10"></div>

  <div {{ cls }}="w-container flex flex-col items-center gap-8 px-6 pb-12 pt-16 text-center md:px-10 md:pb-16 md:pt-28">
    <a href="/about" {{ cls }}="badge">
      <span {{ cls }}="badge-dot"></span>
      Nexy v{{ nexy_version }} &middot; {{ fw_label }}
      <span aria-hidden="true">&#8594;</span>
    </a>
    <h1 {{ cls }}="max-w-4xl text-4xl leading-[1.02] sm:text-5xl md:text-7xl">
      Full-stack Python,<br />
      <span {{ cls }}="text-accent">modern on every screen.</span>
    </h1>
    <p {{ cls }}="lead">
      Routes are files. Pages render on the server, interactive parts load only where you ask for them,
      and the API lives next to the views.
    </p>
    <div {{ cls }}="flex flex-wrap justify-center gap-3">
      <a href="https://github.com/NexyPy/nexy#readme" target="_blank" rel="noopener noreferrer" {{ cls }}="btn-primary">
        Get started
        <span aria-hidden="true">&#8594;</span>
      </a>
      <a href="https://github.com/NexyPy/nexy" target="_blank" rel="noopener noreferrer" {{ cls }}="btn-ghost">
        Star on GitHub
      </a>
    </div>
  </div>

  <div {{ cls }}="w-container grid items-stretch gap-6 px-6 pb-14 md:px-10 md:pb-20 lg:grid-cols-2">
    <div {{ cls }}="window">
      <div {{ cls }}="window-bar">
        <span {{ cls }}="window-dot"></span>
        <span {{ cls }}="window-dot"></span>
        <span {{ cls }}="window-dot"></span>
        <span {{ cls }}="eyebrow ml-3">Every file is a URL</span>
      </div>
      <div {{ cls }}="window-body">
        <div {{ cls }}="text-foreground/50">src/routes/</div>
        <div {{ cls }}="flex"><span {{ cls }}="w-56 shrink-0">&#9500;&#9472; index{{ page_ext }}</span><span {{ cls }}="text-accent">/</span></div>
        <div {{ cls }}="flex"><span {{ cls }}="w-56 shrink-0">&#9500;&#9472; about{{ page_ext }}</span><span {{ cls }}="text-accent">/about</span></div>
        <div {{ cls }}="flex"><span {{ cls }}="w-56 shrink-0">&#9500;&#9472; contributors{{ page_ext }}</span><span {{ cls }}="text-accent">/contributors</span></div>
        <div>&#9492;&#9472; users/</div>
        <div {{ cls }}="flex"><span {{ cls }}="w-56 shrink-0 pl-6">&#9492;&#9472; [id].py</span><span {{ cls }}="text-accent">/users/:id <span {{ cls }}="text-foreground/50">(API)</span></span></div>
        <div {{ cls }}="mt-5"><span {{ cls }}="text-accent">$</span> nexy dev</div>
        <div {{ cls }}="text-foreground/50">Ready, with hot reload</div>
      </div>
    </div>
    <div {{ cls }}="dark rounded-2xl border border-dashed border-border bg-background p-3">
      <{{ card }} />
    </div>
  </div>
</section>

<section {{ cls }}="section border-t border-dashed border-border">
  <p {{ cls }}="eyebrow">Why Nexy</p>
  <h2 {{ cls }}="section-title mt-3 max-w-2xl">One project for the server, the pages and the API.</h2>
  <div {{ cls }}="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <div {{ cls }}="card">
      <p {{ cls }}="card-title">File-based routing</p>
      <p {{ cls }}="card-text">Create a file in <code>src/routes</code> and it is a URL. Dynamic segments, groups and layouts nest like folders.</p>
    </div>
    <div {{ cls }}="card">
      <p {{ cls }}="card-title">Server-rendered pages</p>
      <p {{ cls }}="card-text">Pages render in Python with Jinja templates and arrive as plain HTML, ready to read before any script runs.</p>
    </div>
    <div {{ cls }}="card">
      <p {{ cls }}="card-title">Client routing</p>
      <p {{ cls }}="card-text">Turn on <code>useCSR</code> to navigate without reloads with React, Preact, Solid, Vue or Svelte.</p>
    </div>
    <div {{ cls }}="card">
      <p {{ cls }}="card-title">Islands</p>
      <p {{ cls }}="card-text">Drop an interactive component into a server page. Only that component loads in the browser.</p>
    </div>
    <div {{ cls }}="card">
      <p {{ cls }}="card-title">API routes</p>
      <p {{ cls }}="card-text">Export <code>GET</code> or <code>POST</code> from a Python file. Handlers use FastAPI request and response types.</p>
    </div>
    <div {{ cls }}="card">
      <p {{ cls }}="card-title">Fast feedback</p>
      <p {{ cls }}="card-text">Vite hot reload, an overlay for compile errors and a dev log that names exactly what changed.</p>
    </div>
  </div>
</section>

<section {{ cls }}="section border-t border-dashed border-border">
  <div {{ cls }}="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
    <div>
      <h2 {{ cls }}="section-title">Start with the file in front of you.</h2>
      <p {{ cls }}="lead mt-3">Edit <code>src/routes/index{{ page_ext }}</code> and save. The page updates without a reload.</p>
    </div>
    <a href="/about" {{ cls }}="btn-ghost shrink-0">Read about Nexy <span aria-hidden="true">&#8594;</span></a>
  </div>
</section>
