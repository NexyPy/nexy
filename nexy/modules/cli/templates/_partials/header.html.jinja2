<header {{ cls }}="sticky top-0 z-30 border-b border-dashed border-border bg-background/80 backdrop-blur">
  <nav {{ cls }}="w-container flex items-center justify-between gap-4 px-6 md:px-10 py-3.5" aria-label="Main">
    <div {{ cls }}="flex items-center gap-6 md:gap-8">
      <a href="/" aria-label="Nexy home" {{ cls }}="dark:hue-rotate-140 dark:invert">
        <img src="/public/nexy.svg" alt="Nexy" {{ cls }}="w-20" />
      </a>
      <ul {{ cls }}="flex items-center gap-4 md:gap-6">
        <li><a href="/about" {{ cls }}="eyebrow ease hover:text-foreground">About</a></li>
        <li><a href="/contributors" {{ cls }}="eyebrow ease hover:text-foreground">Contributors</a></li>
        <li {{ cls }}="hidden sm:block">
          <a href="https://github.com/NexyPy/nexy#readme" target="_blank" rel="noopener noreferrer" {{ cls }}="eyebrow ease hover:text-foreground">Docs</a>
        </li>
      </ul>
    </div>
    <a href="https://github.com/NexyPy/nexy" target="_blank" rel="noopener noreferrer" {{ cls }}="btn-primary">
      GitHub
      <span aria-hidden="true">&#8599;</span>
    </a>
  </nav>
</header>
