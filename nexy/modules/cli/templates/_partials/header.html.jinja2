{%- macro nav_link(href, label, extra_class="nx-nav-link", on_click="") -%}
{%- if useCSR -%}
<Link href="{{ href }}" {{ cls }}="{{ extra_class }}"{% if on_click %} {{ on_click }}{% endif %}>{{ label }}</Link>
{%- else -%}
<a href="{{ href }}" {{ cls }}="{{ extra_class }}">{{ label }}</a>
{%- endif -%}
{%- endmacro -%}
{#- A client-routed page runs no inline script: its menu is the Sheet component, bound in the syntax
    of the framework. The layout or the Header component holds `open`, `opener` and `close`. -#}
{%- set stroke = "strokeWidth" if client_framework == "react" else "stroke-width" -%}
{%- if useCSR and client_framework == "vue" -%}
{%- set opens = '@click="open = true"' -%}
{%- set expanded = ':aria-expanded="open"' -%}
{%- set opener = 'ref="opener"' -%}
{%- set closes = '@click="close"' -%}
{%- set sheet = '<Sheet id="nx-menu" :open="open" title="Menu" @close="close">' -%}
{%- elif useCSR and client_framework == "svelte" -%}
{%- set opens = 'onclick={() => (open = true)}' -%}
{%- set expanded = 'aria-expanded={open}' -%}
{%- set opener = 'bind:this={opener}' -%}
{%- set closes = 'onclick={close}' -%}
{%- set sheet = '<Sheet id="nx-menu" {open} title="Menu" onclose={close}>' -%}
{%- elif useCSR -%}
{%- set state = "open()" if client_framework == "solid" else "open" -%}
{%- set opens = 'onClick={() => setOpen(true)}' -%}
{%- set expanded = 'aria-expanded={' ~ state ~ '}' -%}
{%- set opener = 'ref={opener}' -%}
{%- set closes = 'onClick={close}' -%}
{%- set sheet = '<Sheet id="nx-menu" open={' ~ state ~ '} onClose={close} title="Menu">' -%}
{%- endif -%}
<header {{ cls }}="nx-header" data-menu>
  <nav {{ cls }}="nx-container nx-header-inner" aria-label="Main">
    <div {{ cls }}="nx-nav">
      <a href="/" aria-label="Nexy, home" {{ cls }}="nx-brand">
        <img src="/nexy.svg" alt="Nexy" />
      </a>
      <div {{ cls }}="nx-nav-links">
        {{ nav_link("/", "Home") }}
        {{ nav_link("/about", "About") }}
        {{ nav_link("/todos", "Todos") }}
        <a href="https://github.com/NexyPy/nexy#readme" target="_blank" rel="noopener noreferrer" {{ cls }}="nx-nav-link">Docs</a>
      </div>
    </div>
    <div {{ cls }}="nx-header-actions">
{% if useCSR %}
      <ThemeToggle />
      <button type="button" {{ cls }}="nx-menu-button" aria-label="Open menu" {{ expanded }} aria-controls="nx-menu" {{ opener }} {{ opens }}>
        <span {{ cls }}="nx-menu-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" {{ stroke }}="1.8"><path d="M4 7h16M4 12h16M4 17h16" /></svg></span>
      </button>
{% else %}
{% include "theme_switch.html.jinja2" %}
      <button type="button" {{ cls }}="nx-menu-button" aria-label="Open menu" aria-expanded="false" aria-controls="nx-menu" data-menu-button>
        <span {{ cls }}="nx-menu-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16" /></svg></span>
      </button>
{% endif %}
    </div>
  </nav>
</header>
{% if useCSR %}
{{ sheet }}
  {{ nav_link("/", "Home", "nx-sheet-link", closes) }}
  {{ nav_link("/about", "About", "nx-sheet-link", closes) }}
  {{ nav_link("/todos", "Todos", "nx-sheet-link", closes) }}
  <a href="https://github.com/NexyPy/nexy#readme" target="_blank" rel="noopener noreferrer" {{ cls }}="nx-sheet-link" {{ closes }}>Docs<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" {{ stroke }}="1.8" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg></a>
</Sheet>
{% endif %}
{% if not useCSR %}
<div {{ cls }}="nx-sheet-layer" data-menu-panel hidden>
  <div {{ cls }}="nx-sheet-scrim" data-menu-scrim data-state="closed" aria-hidden="true"></div>
  <div {{ cls }}="nx-sheet" id="nx-menu" role="dialog" aria-modal="true" aria-labelledby="nx-menu-title" tabindex="-1" data-state="closed" data-menu-dialog>
    <div {{ cls }}="nx-sheet-head">
      <img src="/nexy.svg" alt="" />
      <h2 {{ cls }}="nx-sheet-title" id="nx-menu-title">Menu</h2>
    </div>
    <button type="button" {{ cls }}="nx-menu-button nx-menu-close" aria-label="Close menu" data-menu-dismiss>
      <span {{ cls }}="nx-menu-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 6L6 18M6 6l12 12" /></svg></span>
    </button>
    <nav {{ cls }}="nx-sheet-links" aria-label="Pages">
      {{ nav_link("/", "Home", "nx-sheet-link") }}
      {{ nav_link("/about", "About", "nx-sheet-link") }}
      {{ nav_link("/todos", "Todos", "nx-sheet-link") }}
      <a href="https://github.com/NexyPy/nexy#readme" target="_blank" rel="noopener noreferrer" {{ cls }}="nx-sheet-link">Docs<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg></a>
    </nav>
  </div>
</div>
<script>
  // Server pages reload on every link: mark the current one.
  const here = location.pathname.replace(/\/$/, "") || "/";
  for (const link of document.querySelectorAll("header a[href^='/'], [data-menu-dialog] a[href^='/']")) {
    if ((link.pathname.replace(/\/$/, "") || "/") === here) link.setAttribute("aria-current", "page");
  }

  // The mobile menu is a modal sheet. While it is open it holds the keyboard (Tab wraps inside it,
  // Escape closes it from anywhere), the page behind holds still, and a wide screen closes it.
  // Closing plays the slide back, then hides the sheet and gives the focus back to the button.
  (function () {
    const button = document.querySelector("[data-menu-button]");
    const layer = document.querySelector("[data-menu-panel]");
    if (!button || !layer) return;
    const dialog = layer.querySelector("[data-menu-dialog]");
    const scrim = layer.querySelector("[data-menu-scrim]");
    const wide = window.matchMedia("(min-width: 48rem)");

    function set_open(open) {
      dialog.dataset.state = open ? "open" : "closed";
      scrim.dataset.state = dialog.dataset.state;
      button.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
    }

    function open_menu() {
      layer.hidden = false;
      set_open(true);
      dialog.focus();
    }

    function close_menu() {
      if (dialog.dataset.state !== "open") return;
      set_open(false);
      button.focus();
      Promise.all(dialog.getAnimations().map((move) => move.finished)).then(function () {
        if (dialog.dataset.state === "closed") layer.hidden = true;
      });
    }

    // Tab and Shift+Tab wrap inside the sheet instead of walking out into the page.
    function trap(event) {
      const stops = dialog.querySelectorAll("a[href], button");
      const first = stops[0];
      const last = stops[stops.length - 1];
      const here = document.activeElement;
      const away = event.shiftKey ? here === first || here === dialog : here === last;
      if (!away) return;
      event.preventDefault();
      (event.shiftKey ? last : first).focus();
    }

    button.addEventListener("click", open_menu);
    layer.addEventListener("click", function (event) {
      if (event.target.closest("[data-menu-dismiss],[data-menu-scrim]")) close_menu();
    });
    document.addEventListener("keydown", function (event) {
      if (dialog.dataset.state !== "open") return;
      if (event.key === "Escape") close_menu();
      if (event.key === "Tab") trap(event);
    });
    wide.addEventListener("change", function () {
      if (wide.matches) close_menu();
    });
  })();
</script>
{% endif %}
