{%- macro nav_link(href, label) -%}
{%- if useCSR -%}
<Link href="{{ href }}" {{ cls }}="nav-link">{{ label }}</Link>
{%- else -%}
<a href="{{ href }}" {{ cls }}="nav-link">{{ label }}</a>
{%- endif -%}
{%- endmacro -%}
<header {{ cls }}="border-b border-border">
  <nav {{ cls }}="mx-auto flex h-14 w-full max-w-5xl items-center justify-between px-6" aria-label="Main">
    <div {{ cls }}="flex items-center gap-8">
      <a href="/" aria-label="Nexy" {{ cls }}="grayscale dark:invert">
        <img src="/nexy.svg" alt="Nexy" {{ cls }}="h-5 w-auto" />
      </a>
      <div {{ cls }}="flex items-center gap-6">
        {{ nav_link("/", "Home") }}
        {{ nav_link("/about", "About") }}
      </div>
    </div>
{% if useCSR %}
    <ThemeToggle />
{% else %}
    <button type="button" data-theme-toggle aria-label="Toggle theme" {{ cls }}="theme-toggle">
{% include "theme_icons.html.jinja2" %}
    </button>
{% endif %}
  </nav>
</header>
{% if not useCSR %}
<script>
  // Server pages reload on every link: mark the current one, and wire the theme button.
  const here = location.pathname.replace(/\/$/, "") || "/";
  for (const link of document.querySelectorAll("header a[href^='/']")) {
    if ((link.pathname.replace(/\/$/, "") || "/") === here) link.setAttribute("aria-current", "page");
  }
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("nexy-theme", dark ? "dark" : "light");
    } catch {}
  });
</script>
{% endif %}
