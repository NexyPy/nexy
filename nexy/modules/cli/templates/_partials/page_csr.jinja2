{#- A starter page of a client-routed project, in the syntax of the chosen framework.
    The includer sets: page_name and page_partial. -#}
{%- set page_ext = ".vue" if client_framework == "vue" else (".svelte" if client_framework == "svelte" else ".tsx") -%}
{%- if client_framework == "vue" -%}
<template>
{% include page_partial %}
</template>
{%- elif client_framework == "svelte" -%}
{% include page_partial %}
{%- else -%}
export default function {{ page_name }}() {
  return (
    <>
{% include page_partial %}
    </>
  );
}
{%- endif %}
