{#- The light/dark switch. It holds no logic: the script in the layout's <head> flips the theme and
    keeps aria-checked in step, so the same markup works in every framework. -#}
{% set sw = "strokeWidth" if cls == "className" else "stroke-width" -%}
{% set cap = "strokeLinecap" if cls == "className" else "stroke-linecap" -%}
{% set join = "strokeLinejoin" if cls == "className" else "stroke-linejoin" -%}
<button type="button" role="switch" aria-checked="false" aria-label="Dark mode" data-theme-toggle {{ cls }}="nx-switch"{% if cls == "className" %} suppressHydrationWarning{% endif %}>
  <span {{ cls }}="nx-switch-thumb">
    <svg {{ cls }}="nx-switch-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" {{ sw }}="2" {{ cap }}="round" {{ join }}="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
    <svg {{ cls }}="nx-switch-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" {{ sw }}="2" {{ cap }}="round" {{ join }}="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
    </svg>
  </span>
</button>
