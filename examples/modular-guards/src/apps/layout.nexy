---
from nexy import Vite

children: prop[NexyElement]
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Newsroom</title>
    <meta name="description" content="A newsroom API with guards: anyone reads, a key writes, an editor publishes.">
    <Vite />
</head>
<body class="mx-auto max-w-2xl px-4 py-10">
    <main>{{ children }}</main>
</body>
</html>
