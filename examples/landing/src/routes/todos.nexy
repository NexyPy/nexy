<section class="mx-auto grid w-full max-w-[72rem] grid-cols-[minmax(0,1fr)] gap-12 px-6 pb-20 pt-[8.5rem] lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:items-start lg:gap-[4.5rem]" data-todos data-task-class="min-w-0 flex-1 cursor-text leading-snug [overflow-wrap:anywhere]" data-done-class="min-w-0 flex-1 cursor-text leading-snug [overflow-wrap:anywhere] text-foreground-second line-through decoration-border-second" data-edit-class="min-h-10 min-w-0 flex-1 border border-foreground bg-background px-3 text-foreground focus:outline-none" data-todos="{{ __actions_path['todos'] }}" data-add-todo="{{ __actions_path['add_todo'] }}" data-toggle-todo="{{ __actions_path['toggle_todo'] }}" data-rename-todo="{{ __actions_path['rename_todo'] }}" data-delete-todo="{{ __actions_path['delete_todo'] }}" data-clear-done="{{ __actions_path['clear_done'] }}">
  <header class="min-w-0">
    <p class="flex items-center gap-2.5 font-mono text-[0.72rem] uppercase tracking-[0.08em] text-foreground-second before:h-1.5 before:w-1.5 before:bg-current before:content-['']">Client and server</p>
    <h1 class="mt-4 text-[clamp(2.6rem,6vw,3.6rem)] leading-[1.02] tracking-[-0.02em]">Todos</h1>
    <p class="mt-5 max-w-[40ch] leading-relaxed text-foreground-second">
      Each change calls an action of <code class="font-mono text-[0.85em] text-foreground">src/actions/todos.py</code>, and the page shows the list
      the server answers with. The tasks live in the <code class="font-mono text-[0.85em] text-foreground">todos</code> table of
      your database.
    </p>
    <dl class="mt-8 divide-y divide-border border border-border bg-background-second">
      <div class="flex justify-between gap-4 px-4 py-3 text-sm">
        <dt class="font-mono text-foreground-second">Last call</dt>
        <dd class="text-right font-mono tabular-nums"><span data-todos-call>none</span></dd>
      </div>
      <div class="flex justify-between gap-4 px-4 py-3 text-sm">
        <dt class="font-mono text-foreground-second">Answered in</dt>
        <dd class="text-right font-mono tabular-nums"><span data-todos-took>...</span></dd>
      </div>
      <div class="flex justify-between gap-4 px-4 py-3 text-sm">
        <dt class="font-mono text-foreground-second">Stored in</dt>
        <dd class="text-right font-mono tabular-nums">todos table</dd>
      </div>
    </dl>
  </header>
  <div class="border border-border bg-background shadow-[0_24px_60px_-32px_rgb(0_0_0/0.25)]">
    <form class="flex gap-2 border-b border-border p-4" data-todos-new>
      <input class="min-h-12 min-w-0 flex-1 border border-border-second bg-background px-4 text-base text-foreground placeholder:text-foreground-second focus:border-foreground focus:outline-none" name="title" placeholder="What needs to be done?" aria-label="New task" maxlength="200" autocomplete="off" />
      <button class="min-h-12 whitespace-nowrap border border-foreground bg-foreground px-6 font-mono text-[0.8rem] font-semibold uppercase tracking-[0.05em] text-background transition-opacity hover:opacity-85 disabled:cursor-progress disabled:opacity-50" type="submit">Add</button>
    </form>
    <p class="px-4 pt-3 text-sm text-foreground empty:hidden" aria-live="polite" data-todos-note></p>
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-border px-4 py-2.5">
      <div class="flex gap-1" role="group" aria-label="Show">
        <button type="button" class="inline-flex min-h-10 items-center gap-2 border border-transparent px-3 text-[0.9rem] text-foreground-second hover:text-foreground aria-pressed:border-border-second aria-pressed:text-foreground" aria-pressed="true" data-filter="all">All <span class="font-mono text-xs text-foreground-second">0</span></button>
        <button type="button" class="inline-flex min-h-10 items-center gap-2 border border-transparent px-3 text-[0.9rem] text-foreground-second hover:text-foreground aria-pressed:border-border-second aria-pressed:text-foreground" aria-pressed="false" data-filter="todo">To do <span class="font-mono text-xs text-foreground-second">0</span></button>
        <button type="button" class="inline-flex min-h-10 items-center gap-2 border border-transparent px-3 text-[0.9rem] text-foreground-second hover:text-foreground aria-pressed:border-border-second aria-pressed:text-foreground" aria-pressed="false" data-filter="done">Done <span class="font-mono text-xs text-foreground-second">0</span></button>
      </div>
      <button type="button" class="min-h-10 px-2 text-[0.9rem] text-foreground-second underline underline-offset-4 hover:text-foreground disabled:hidden" disabled data-todos-clear>Clear done</button>
    </div>
    <ul class="divide-y divide-border" aria-label="Tasks" data-todos-list></ul>
    <p class="px-6 py-12 text-center text-foreground-second" data-todos-empty>Asking the server for the tasks...</p>
    <footer class="flex justify-between gap-4 border-t border-border px-4 py-3 font-mono text-xs uppercase tracking-[0.04em] text-foreground-second">
      <span><span data-todos-left>0</span> left</span>
      <span><span data-todos-total>0</span> on the server</span>
    </footer>
    <template data-todos-row>
      <li class="flex min-h-14 items-center gap-3.5 py-1.5 pl-4 pr-2.5">
        <input type="checkbox" class="grid h-[1.4rem] w-[1.4rem] flex-none cursor-pointer appearance-none place-content-center border-[1.5px] border-border-second bg-background transition-colors hover:border-foreground checked:border-signal checked:bg-signal after:-mt-0.5 after:h-[0.8rem] after:w-[0.45rem] after:rotate-45 after:scale-0 after:border-b-2 after:border-r-2 after:border-background after:content-[''] after:transition-transform checked:after:scale-100" data-check />
        <span class="min-w-0 flex-1 cursor-text leading-snug [overflow-wrap:anywhere]" data-title></span>
        <div class="flex flex-none gap-0.5">
          <button type="button" class="grid h-10 w-10 place-items-center text-foreground-second transition-colors hover:bg-background-second hover:text-foreground" aria-label="Rename" data-rename><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" aria-hidden="true"><path d="M10.5 2.5l3 3L6 13H3v-3z" /></svg></button>
          <button type="button" class="grid h-10 w-10 place-items-center text-foreground-second transition-colors hover:bg-background-second hover:text-foreground" data-danger aria-label="Delete" data-delete><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg></button>
        </div>
      </li>
    </template>
  </div>
</section>
<script>
  (function () {
    const root = document.querySelector("[data-todos]");
    if (!root) return;
    const $ = (selector) => root.querySelector(selector);
    const list = $("[data-todos-list]");
    const row = $("[data-todos-row]");
    const form = $("[data-todos-new]");
    const EMPTY = { all: "Nothing to do. Add a first task above.", todo: "Nothing left to do.", done: "Nothing done yet." };
    let items = [];
    let filter = "all";

    // Calls one action, times it, and shows the list the server answered with.
    async function call(name, body) {
      const started = performance.now();
      $("[data-todos-call]").textContent = name;
      try {
        const response = await fetch(root.dataset[name.replace(/_(.)/g, (_, c) => c.toUpperCase())], {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify(body || {}),
        });
        if (!response.ok) throw new Error(response.status + " " + response.statusText);
        const board = await response.json();
        $("[data-todos-took]").textContent = Math.round(performance.now() - started) + " ms";
        $("[data-todos-note]").textContent = board.note;
        items = board.items;
        render();
        return !board.note;
      } catch (error) {
        $("[data-todos-took]").textContent = "no answer";
        $("[data-todos-note]").textContent = "No answer from the server: " + error.message;
        return false;
      }
    }

    const matches = (todo, key) => key === "all" || todo.done === (key === "done");

    function item(todo) {
      const li = row.content.firstElementChild.cloneNode(true);
      const check = li.querySelector("[data-check]");
      const title = li.querySelector("[data-title]");
      li.dataset.id = todo.id;
      check.checked = todo.done;
      check.setAttribute("aria-label", "Done: " + todo.title);
      title.className = todo.done ? root.dataset.doneClass : root.dataset.taskClass;
      title.textContent = todo.title;
      return li;
    }

    function render() {
      const visible = items.filter((todo) => matches(todo, filter));
      list.replaceChildren(...visible.map(item));
      $("[data-todos-empty]").hidden = visible.length > 0;
      $("[data-todos-empty]").textContent = EMPTY[filter];
      root.querySelectorAll("[data-filter]").forEach(function (button) {
        button.setAttribute("aria-pressed", button.dataset.filter === filter);
        button.lastElementChild.textContent = items.filter((todo) => matches(todo, button.dataset.filter)).length;
      });
      $("[data-todos-clear]").disabled = !items.some((todo) => todo.done);
      $("[data-todos-left]").textContent = items.filter((todo) => !todo.done).length;
      $("[data-todos-total]").textContent = items.length;
    }

    // Swaps a title for a field: Enter or leaving the field saves, Escape gives up.
    function edit(li) {
      const todo = items.find((one) => String(one.id) === li.dataset.id);
      const field = document.createElement("input");
      field.className = root.dataset.editClass;
      field.value = todo.title;
      field.setAttribute("aria-label", "Rename the task");
      let done = false;
      const finish = function (save) {
        if (done) return;
        done = true;
        if (save && field.value.trim() !== todo.title) call("rename_todo", { todo_id: todo.id, title: field.value });
        else render();
      };
      field.addEventListener("keydown", function (event) {
        if (event.key === "Enter") finish(true);
        if (event.key === "Escape") finish(false);
      });
      field.addEventListener("blur", () => finish(true));
      li.querySelector("[data-title]").replaceWith(field);
      field.focus();
    }

    form.addEventListener("submit", async function (event) {
      event.preventDefault();
      form.lastElementChild.disabled = true;
      if (await call("add_todo", { title: form.elements.title.value })) form.reset();
      form.lastElementChild.disabled = false;
    });
    list.addEventListener("change", function (event) {
      if (event.target.matches("[data-check]")) {
        call("toggle_todo", { todo_id: Number(event.target.closest("li").dataset.id) });
      }
    });
    list.addEventListener("dblclick", function (event) {
      if (event.target.matches("[data-title]")) edit(event.target.closest("li"));
    });
    list.addEventListener("click", function (event) {
      const li = event.target.closest("li");
      if (event.target.closest("[data-rename]")) edit(li);
      if (event.target.closest("[data-delete]")) call("delete_todo", { todo_id: Number(li.dataset.id) });
    });
    root.querySelectorAll("[data-filter]").forEach(function (button) {
      button.addEventListener("click", function () {
        filter = button.dataset.filter;
        render();
      });
    });
    $("[data-todos-clear]").addEventListener("click", () => call("clear_done"));
    call("todos");
  })();
</script>
