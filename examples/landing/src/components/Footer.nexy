---
from "@/components/Logo.nexy" import Logo

links = [("/#features", "Features"), ("/#pricing", "Pricing"), ("/#faq", "FAQ"), ("/changelog", "Changelog")]
---
<footer class="border-t border-border">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-12 sm:px-6 md:flex-row md:items-start md:justify-between">
    <div class="max-w-sm">
      <a href="/" class="flex h-11 w-fit items-center gap-2.5 font-semibold tracking-tight"><Logo size="22" /> Beacon</a>
      <p class="mt-3 text-sm leading-relaxed text-foreground-second">
        Beacon is a made-up product: the landing example of
        <a href="https://github.com/NexyPy/nexy" class="text-foreground underline underline-offset-4 hover:text-signal">Nexy</a>.
        The form keeps your email in a local SQLite file and sends nothing.
      </p>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 gap-x-10 text-sm sm:grid-cols-3">
      {% for href, label in links %}
      <a href="{{ href }}" class="flex min-h-11 items-center text-foreground-second hover:text-foreground">{{ label }}</a>
      {% endfor %}
      <a href="https://github.com/NexyPy/nexy/tree/main/examples/landing" class="flex min-h-11 items-center text-foreground-second hover:text-foreground">The code</a>
    </nav>
  </div>
</footer>
