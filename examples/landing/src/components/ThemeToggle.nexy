---
from "@/components/Icon.nexy" import Icon

sun = "M12 3v2M12 19v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M3 12h2M19 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4M12 8a4 4 0 100 8 4 4 0 000-8z"
moon = "M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"
---
<button
  type="button"
  aria-label="Switch between light and dark"
  data-theme-toggle
  class="grid size-11 place-items-center rounded-lg text-foreground-second transition-colors hover:bg-background-second hover:text-foreground"
>
  <span class="dark:hidden"><Icon path="{{ sun }}" size="18" /></span>
  <span class="hidden dark:block"><Icon path="{{ moon }}" size="18" /></span>
</button>
<script>
  // The head applies the saved theme before the first paint; this button flips it and keeps it.
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", function () {
    var dark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("nexy-theme", dark ? "dark" : "light");
    } catch (error) {}
  });
</script>
