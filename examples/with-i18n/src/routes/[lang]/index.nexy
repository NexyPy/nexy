---
from nexy import notFound, setMetadata
from src.i18n import LANGUAGES, t

lang: prop[str]
if lang not in LANGUAGES:
    notFound()
free_tables = 3
setMetadata(title=t(lang, "home.title"), description=t(lang, "home.lead"))
---
<h1 class="text-3xl font-semibold">{{ t(lang, "home.title") }}</h1>
<p class="mt-3 text-foreground-second">{{ t(lang, "home.lead") }}</p>
<p class="mt-6 rounded-lg bg-background-second px-4 py-3 text-sm">{{ t(lang, "home.tables", count=free_tables) }}</p>
