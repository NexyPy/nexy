---
from nexy import Vite, setMetadata, useMetadata

children: prop[NexyElement]
setMetadata(title_template="%s | Bookmarks")
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ useMetadata().html() }}
    <Vite />
</head>
<body class="mx-auto max-w-2xl px-4 py-10">
    <main>{{ children }}</main>
</body>
</html>
