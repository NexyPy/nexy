---
post: prop[object]
---
<li class="border-b border-border py-6 last:border-b-0">
  <p class="font-mono text-xs uppercase tracking-[0.04em] text-foreground-second">
    <time datetime="{{ post.date.isoformat() }}">{{ post.date.strftime("%d %B %Y") }}</time>, {{ post.minutes }} min read
  </p>
  <h2 class="mt-2 text-2xl leading-tight"><a href="/posts/{{ post.slug }}" class="hover:underline hover:underline-offset-4">{{ post.title }}</a></h2>
  <p class="mt-2 text-foreground-second">{{ post.summary }}</p>
  <ul class="mt-3 flex flex-wrap gap-2" aria-label="Tags">
    {% for tag in post.tags %}
    <li><a href="/tags/{{ tag }}" class="border border-border px-2 py-1 font-mono text-xs hover:border-foreground">{{ tag }}</a></li>
    {% endfor %}
  </ul>
</li>
