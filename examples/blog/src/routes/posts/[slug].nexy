---
from "@/components/Container.nexy" import Container
from nexy import notFound
from src.blog.posts import find, neighbours

slug: prop[str]

post = find(slug)
if post is None:
    notFound()
newer = neighbours(slug)[0]
older = neighbours(slug)[1]
---
<article class="pb-20 pt-36">
  <Container class_name="grid gap-12 lg:grid-cols-[1fr_14rem]">
    <div class="min-w-0 max-w-[44rem]">
      <p class="font-mono text-xs uppercase tracking-[0.04em] text-foreground-second">
        <time datetime="{{ post.date.isoformat() }}">{{ post.date.strftime("%d %B %Y") }}</time>, {{ post.minutes }} min read
      </p>
      <h1 class="mt-3 text-5xl leading-[1.05]">{{ post.title }}</h1>
      <div class="prose mt-10">{{ post.html | safe }}</div>
      <ul class="mt-10 flex flex-wrap gap-2" aria-label="Tags">
        {% for tag in post.tags %}
        <li><a href="/tags/{{ tag }}" class="border border-border px-2 py-1 font-mono text-xs hover:border-foreground">{{ tag }}</a></li>
        {% endfor %}
      </ul>
      <nav class="mt-12 grid gap-4 border-t border-border pt-6 sm:grid-cols-2" aria-label="More posts">
        {% if older %}<a href="/posts/{{ older.slug }}" class="hover:underline"><span class="block font-mono text-xs uppercase text-foreground-second">Older</span>{{ older.title }}</a>{% else %}<span></span>{% endif %}
        {% if newer %}<a href="/posts/{{ newer.slug }}" class="hover:underline sm:text-right"><span class="block font-mono text-xs uppercase text-foreground-second">Newer</span>{{ newer.title }}</a>{% endif %}
      </nav>
    </div>
    {% if post.toc %}
    <nav class="hidden lg:block" aria-label="On this page">
      <div class="sticky top-28">
        <p class="font-mono text-xs uppercase tracking-[0.04em] text-foreground-second">On this page</p>
        <ul class="mt-3 grid gap-2 text-sm">
          {% for anchor, heading in post.toc %}
          <li><a href="#{{ anchor }}" class="text-foreground-second hover:text-foreground">{{ heading }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </nav>
    {% endif %}
  </Container>
</article>
