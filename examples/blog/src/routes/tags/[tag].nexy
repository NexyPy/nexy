---
from "@/components/Container.nexy" import Container
from "@/components/PostCard.nexy" import PostCard
from nexy import notFound
from src.blog.posts import tagged

tag: prop[str]

posts = tagged(tag)
if not posts:
    notFound()
---
<section class="pb-20 pt-36">
  <Container class_name="max-w-[44rem]">
    <p class="font-mono text-xs uppercase tracking-[0.04em] text-foreground-second"><a href="/tags" class="hover:underline">Tags</a></p>
    <h1 class="mt-3 text-5xl leading-[1.05]">{{ tag }}</h1>
    <p class="mt-4 text-foreground-second">{{ posts | length }} post{{ "" if posts | length == 1 else "s" }}</p>
    <ul class="mt-8" aria-label="Posts">
      {% for post in posts %}
      <PostCard post="{{ post }}" />
      {% endfor %}
    </ul>
  </Container>
</section>
