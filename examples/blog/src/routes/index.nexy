---
from "@/components/Container.nexy" import Container
from "@/components/PostCard.nexy" import PostCard
from src.blog.posts import all_posts

posts = all_posts()
---
<section class="pb-20 pt-36">
  <Container class_name="max-w-[44rem]">
    <h1 class="text-5xl leading-[1.05]">Notes</h1>
    <p class="mt-4 text-lg text-foreground-second">
      An example blog: Markdown files rendered by Python on the server.
    </p>
    <ul class="mt-10" aria-label="Posts">
      {% for post in posts %}
      <PostCard post="{{ post }}" />
      {% endfor %}
    </ul>
  </Container>
</section>
