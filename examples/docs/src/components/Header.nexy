---
from "@/components/ThemeToggle.nexy" import ThemeToggle
from "@/components/search-box.tsx" import SearchBox
---
<header class="sticky top-0 z-20 border-b border-border bg-background/90 backdrop-blur">
  <div class="mx-auto flex h-16 w-full max-w-7xl items-center gap-3 px-4 sm:gap-6 sm:px-6">
    <a href="/" class="flex h-11 shrink-0 items-center gap-2 font-semibold">
      <svg viewBox="0 0 32 32" class="size-7" aria-hidden="true"><rect width="32" height="32" rx="8" fill="currentColor" /><path d="M9 23h14M11 18h10M13 13h6M15 8h2" stroke="var(--background)" stroke-width="2.5" stroke-linecap="round" /></svg>
      <span class="hidden sm:inline">Cairn <span class="font-normal text-foreground-second">docs</span></span>
    </a>
    <div class="min-w-0 flex-1 sm:max-w-md"><SearchBox directive="client:load" /></div>
    <ThemeToggle />
  </div>
</header>
