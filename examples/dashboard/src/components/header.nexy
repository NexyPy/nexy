<header class="nx-header" data-menu>
  <nav class="nx-container nx-header-inner" aria-label="Main">
    <div class="nx-nav">
      <a href="/" aria-label="Nexy, home" class="nx-brand">
        <img src="/nexy.svg" alt="Nexy" />
      </a>
      <div class="nx-nav-links">
        <a href="/" class="nx-nav-link">Home</a>
        <a href="https://github.com/NexyPy/nexy#readme" target="_blank" rel="noopener noreferrer" class="nx-nav-link">Docs</a>
      </div>
    </div>
    <div class="nx-header-actions">

<button type="button" role="switch" aria-checked="false" aria-label="Dark mode" data-theme-toggle class="nx-switch">
  <span class="nx-switch-thumb">
    <svg class="nx-switch-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
    <svg class="nx-switch-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
    </svg>
  </span>
</button>
      <button type="button" class="nx-menu-button" aria-label="Open menu" aria-expanded="false" aria-controls="nx-menu" data-menu-button>
        <span class="nx-menu-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16" /></svg></span>
      </button>

    </div>
  </nav>
</header>


<div class="nx-sheet-layer" data-menu-panel hidden>
  <div class="nx-sheet-scrim" data-menu-scrim data-state="closed" aria-hidden="true"></div>
  <div class="nx-sheet" id="nx-menu" role="dialog" aria-modal="true" aria-labelledby="nx-menu-title" tabindex="-1" data-state="closed" data-menu-dialog>
    <div class="nx-sheet-head">
      <img src="/nexy.svg" alt="" />
      <h2 class="nx-sheet-title" id="nx-menu-title">Menu</h2>
    </div>
    <button type="button" class="nx-menu-button nx-menu-close" aria-label="Close menu" data-menu-dismiss>
      <span class="nx-menu-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 6L6 18M6 6l12 12" /></svg></span>
    </button>
    <nav class="nx-sheet-links" aria-label="Pages">
      <a href="/" class="nx-sheet-link">Home</a>
      <a href="https://github.com/NexyPy/nexy#readme" target="_blank" rel="noopener noreferrer" class="nx-sheet-link">Docs<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg></a>
    </nav>
  </div>
</div>
<script>
  // Server pages reload on every link: mark the current one.
  const here = location.pathname.replace(/\/$/, "") || "/";
  for (const link of document.querySelectorAll("header a[href^='/'], [data-menu-dialog] a[href^='/']")) {
    if ((link.pathname.replace(/\/$/, "") || "/") === here) link.setAttribute("aria-current", "page");
  }

  // The mobile menu is a modal sheet. While it is open it holds the keyboard (Tab wraps inside it,
  // Escape closes it from anywhere), the page behind holds still, and a wide screen closes it.
  // Closing plays the slide back, then hides the sheet and gives the focus back to the button.
  (function () {
    const button = document.querySelector("[data-menu-button]");
    const layer = document.querySelector("[data-menu-panel]");
    if (!button || !layer) return;
    const dialog = layer.querySelector("[data-menu-dialog]");
    const scrim = layer.querySelector("[data-menu-scrim]");
    const wide = window.matchMedia("(min-width: 48rem)");

    function set_open(open) {
      dialog.dataset.state = open ? "open" : "closed";
      scrim.dataset.state = dialog.dataset.state;
      button.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
    }

    function open_menu() {
      layer.hidden = false;
      set_open(true);
      dialog.focus();
    }

    function close_menu() {
      if (dialog.dataset.state !== "open") return;
      set_open(false);
      button.focus();
      Promise.all(dialog.getAnimations().map((move) => move.finished)).then(function () {
        if (dialog.dataset.state === "closed") layer.hidden = true;
      });
    }

    // Tab and Shift+Tab wrap inside the sheet instead of walking out into the page.
    function trap(event) {
      const stops = dialog.querySelectorAll("a[href], button");
      const first = stops[0];
      const last = stops[stops.length - 1];
      const here = document.activeElement;
      const away = event.shiftKey ? here === first || here === dialog : here === last;
      if (!away) return;
      event.preventDefault();
      (event.shiftKey ? last : first).focus();
    }

    button.addEventListener("click", open_menu);
    layer.addEventListener("click", function (event) {
      if (event.target.closest("[data-menu-dismiss],[data-menu-scrim]")) close_menu();
    });
    document.addEventListener("keydown", function (event) {
      if (dialog.dataset.state !== "open") return;
      if (event.key === "Escape") close_menu();
      if (event.key === "Tab") trap(event);
    });
    wide.addEventListener("change", function () {
      if (wide.matches) close_menu();
    });
  })();
</script>
