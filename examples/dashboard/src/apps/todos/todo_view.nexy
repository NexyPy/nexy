<section class="nx-todos" data-todos data-task-class="nx-todo-title" data-done-class="nx-todo-title nx-todo-done" data-edit-class="nx-todo-edit" data-todos="{{ __actions_path['todos'] }}" data-add-todo="{{ __actions_path['add_todo'] }}" data-toggle-todo="{{ __actions_path['toggle_todo'] }}" data-rename-todo="{{ __actions_path['rename_todo'] }}" data-delete-todo="{{ __actions_path['delete_todo'] }}" data-clear-done="{{ __actions_path['clear_done'] }}">
  <header>
    <p class="nx-todos-eyebrow">Client and server</p>
    <h1 class="nx-todos-title">Todos</h1>
    <p class="nx-todos-lead">
      Each change calls an action of <code>src/apps/todos/todo_actions.py</code>, and the page shows the list
      the server answers with. The tasks live in the <code>todos</code> table of
      your database.
    </p>
    <dl class="nx-todos-trip">
      <div>
        <dt>Last call</dt>
        <dd><span data-todos-call>none</span></dd>
      </div>
      <div>
        <dt>Answered in</dt>
        <dd><span data-todos-took>...</span></dd>
      </div>
      <div>
        <dt>Stored in</dt>
        <dd>todos table</dd>
      </div>
    </dl>
  </header>
  <div class="nx-todos-card">
    <form class="nx-todos-new" data-todos-new>
      <input name="title" placeholder="What needs to be done?" aria-label="New task" maxlength="200" autocomplete="off" />
      <button class="nx-todos-add" type="submit">Add</button>
    </form>
    <p class="nx-todos-note" aria-live="polite" data-todos-note></p>
    <div class="nx-todos-bar">
      <div class="nx-todos-filters" role="group" aria-label="Show">
        <button type="button" class="nx-todos-filter" aria-pressed="true" data-filter="all">All <span class="nx-todos-count">0</span></button>
        <button type="button" class="nx-todos-filter" aria-pressed="false" data-filter="todo">To do <span class="nx-todos-count">0</span></button>
        <button type="button" class="nx-todos-filter" aria-pressed="false" data-filter="done">Done <span class="nx-todos-count">0</span></button>
      </div>
      <button type="button" class="nx-todos-clear" disabled data-todos-clear>Clear done</button>
    </div>
    <ul class="nx-todos-list" aria-label="Tasks" data-todos-list></ul>
    <p class="nx-todos-empty" data-todos-empty>Asking the server for the tasks...</p>
    <footer class="nx-todos-foot">
      <span><span data-todos-left>0</span> left</span>
      <span><span data-todos-total>0</span> on the server</span>
    </footer>
    <template data-todos-row>
      <li class="nx-todo">
        <input type="checkbox" class="nx-todo-check" data-check />
        <span class="nx-todo-title" data-title></span>
        <div class="nx-todo-actions">
          <button type="button" class="nx-todo-action" aria-label="Rename" data-rename><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" aria-hidden="true"><path d="M10.5 2.5l3 3L6 13H3v-3z" /></svg></button>
          <button type="button" class="nx-todo-action" data-danger aria-label="Delete" data-delete><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg></button>
        </div>
      </li>
    </template>
  </div>
</section>
<script>
  (function () {
    const root = document.querySelector("[data-todos]");
    if (!root) return;
    const $ = (selector) => root.querySelector(selector);
    const list = $("[data-todos-list]");
    const row = $("[data-todos-row]");
    const form = $("[data-todos-new]");
    const EMPTY = { all: "Nothing to do. Add a first task above.", todo: "Nothing left to do.", done: "Nothing done yet." };
    let items = [];
    let filter = "all";

    // Calls one action, times it, and shows the list the server answered with.
    async function call(name, body) {
      const started = performance.now();
      $("[data-todos-call]").textContent = name;
      try {
        const response = await fetch(root.dataset[name.replace(/_(.)/g, (_, c) => c.toUpperCase())], {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify(body || {}),
        });
        if (!response.ok) throw new Error(response.status + " " + response.statusText);
        const board = await response.json();
        $("[data-todos-took]").textContent = Math.round(performance.now() - started) + " ms";
        $("[data-todos-note]").textContent = board.note;
        items = board.items;
        render();
        return !board.note;
      } catch (error) {
        $("[data-todos-took]").textContent = "no answer";
        $("[data-todos-note]").textContent = "No answer from the server: " + error.message;
        return false;
      }
    }

    const matches = (todo, key) => key === "all" || todo.done === (key === "done");

    function item(todo) {
      const li = row.content.firstElementChild.cloneNode(true);
      const check = li.querySelector("[data-check]");
      const title = li.querySelector("[data-title]");
      li.dataset.id = todo.id;
      check.checked = todo.done;
      check.setAttribute("aria-label", "Done: " + todo.title);
      title.className = todo.done ? root.dataset.doneClass : root.dataset.taskClass;
      title.textContent = todo.title;
      return li;
    }

    function render() {
      const visible = items.filter((todo) => matches(todo, filter));
      list.replaceChildren(...visible.map(item));
      $("[data-todos-empty]").hidden = visible.length > 0;
      $("[data-todos-empty]").textContent = EMPTY[filter];
      root.querySelectorAll("[data-filter]").forEach(function (button) {
        button.setAttribute("aria-pressed", button.dataset.filter === filter);
        button.lastElementChild.textContent = items.filter((todo) => matches(todo, button.dataset.filter)).length;
      });
      $("[data-todos-clear]").disabled = !items.some((todo) => todo.done);
      $("[data-todos-left]").textContent = items.filter((todo) => !todo.done).length;
      $("[data-todos-total]").textContent = items.length;
    }

    // Swaps a title for a field: Enter or leaving the field saves, Escape gives up.
    function edit(li) {
      const todo = items.find((one) => String(one.id) === li.dataset.id);
      const field = document.createElement("input");
      field.className = root.dataset.editClass;
      field.value = todo.title;
      field.setAttribute("aria-label", "Rename the task");
      let done = false;
      const finish = function (save) {
        if (done) return;
        done = true;
        if (save && field.value.trim() !== todo.title) call("rename_todo", { todo_id: todo.id, title: field.value });
        else render();
      };
      field.addEventListener("keydown", function (event) {
        if (event.key === "Enter") finish(true);
        if (event.key === "Escape") finish(false);
      });
      field.addEventListener("blur", () => finish(true));
      li.querySelector("[data-title]").replaceWith(field);
      field.focus();
    }

    form.addEventListener("submit", async function (event) {
      event.preventDefault();
      form.lastElementChild.disabled = true;
      if (await call("add_todo", { title: form.elements.title.value })) form.reset();
      form.lastElementChild.disabled = false;
    });
    list.addEventListener("change", function (event) {
      if (event.target.matches("[data-check]")) {
        call("toggle_todo", { todo_id: Number(event.target.closest("li").dataset.id) });
      }
    });
    list.addEventListener("dblclick", function (event) {
      if (event.target.matches("[data-title]")) edit(event.target.closest("li"));
    });
    list.addEventListener("click", function (event) {
      const li = event.target.closest("li");
      if (event.target.closest("[data-rename]")) edit(li);
      if (event.target.closest("[data-delete]")) call("delete_todo", { todo_id: Number(li.dataset.id) });
    });
    root.querySelectorAll("[data-filter]").forEach(function (button) {
      button.addEventListener("click", function () {
        filter = button.dataset.filter;
        render();
      });
    });
    $("[data-todos-clear]").addEventListener("click", () => call("clear_done"));
    call("todos");
  })();
</script>
