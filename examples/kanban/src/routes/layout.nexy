---
from "@/components/Header.nexy" import Header
from nexy import Vite, setMetadata, useMetadata

children: prop[NexyElement]
setMetadata(title_template="%s | Quill board")
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ useMetadata().html() }}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&display=swap" rel="stylesheet">
    <!-- Applied before the first paint, so a dark page never flashes white. -->
    <style>html{background:#ffffff;color-scheme:light}html.dark{background:#111113;color-scheme:dark}</style>
    <script>
        try {
            var saved = localStorage.getItem("nexy-theme");
            var dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.classList.toggle("dark", dark);
        } catch (error) {}
    </script>
    <Vite />
</head>
<body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-foreground focus:px-4 focus:py-2 focus:text-background">Skip to the board</a>
    <Header />
    <main id="main" class="flex flex-1 flex-col">{{ children }}</main>
    <footer class="border-t border-border">
      <div class="mx-auto flex w-full max-w-7xl flex-col gap-2 px-4 py-4 text-sm text-foreground-second sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p>Quill and its team are made up: this is the kanban example of Nexy.</p>
        <a href="https://github.com/NexyPy/nexy/tree/main/examples/kanban" class="flex min-h-11 items-center underline underline-offset-4 hover:text-foreground">The code of this board</a>
      </div>
    </footer>
</body>
</html>
