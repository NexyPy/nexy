---
from nexy import Vite, setMetadata, useMetadata

children: prop[NexyElement]
setMetadata(title_template="%s | Departures")
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ useMetadata().html() }}
    <Vite />
</head>
<body class="mx-auto max-w-2xl px-4 py-10">
    <nav aria-label="Site" class="flex gap-4 text-sm">
        <a href="/" class="flex min-h-11 items-center">Cached board</a>
        <a href="/live" class="flex min-h-11 items-center">Live board</a>
    </nav>
    <main class="mt-8">{{ children }}</main>
</body>
</html>
