---
from "@/components/header.nexy" import Header
from "@/components/footer.nexy" import Footer
from nexy import Vite

children:prop[NexyElement]
---
<!DOCTYPE html>
<html lang="fr" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexy & React | App </title>
    <Vite />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
</head>

<body class="  antialiased min-h-dvh flex flex-col ">
    <Header />
    <main class="lg:px-20 ">
        {{children | safe}}
        
    </main>
    <Footer />
</body>

</html>