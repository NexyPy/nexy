---
from "@/components/ThemeToggle.nexy" import ThemeToggle
from src.accounts.session import current

account = current()
---
<header class="border-b border-border">
  <div class="mx-auto flex h-16 w-full max-w-5xl items-center gap-2 px-4 sm:px-6">
    <a href="/" class="flex h-11 items-center gap-2 font-semibold">
      <svg viewBox="0 0 32 32" class="size-7" aria-hidden="true"><rect width="32" height="32" rx="8" fill="currentColor" /><path d="M8 22c4-1 6-4 8-9 2 5 4 8 8 9" stroke="var(--background)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
      Kestrel
    </a>
    <nav aria-label="Account" class="ml-auto flex items-center gap-1 text-sm">
      {% if account %}
      <a href="/account" class="flex min-h-11 max-w-48 items-center truncate rounded-md px-3 hover:bg-background-second">Your account</a>
      {% else %}
      <a href="/signin" class="flex min-h-11 items-center rounded-md px-3 hover:bg-background-second">Sign in</a>
      <a href="/signup" class="flex min-h-11 items-center rounded-md bg-accent px-3 font-medium text-on-accent hover:opacity-90">Create an account</a>
      {% endif %}
    </nav>
    <ThemeToggle />
  </div>
</header>
